---
import type { Locale } from '../lib/site';

const { locale = 'zh' } = Astro.props as { locale?: Locale };

const labels = {
  zh: {
    enable: '开启透明水族馆',
    disable: '暂停透明水族馆',
    tooltipOn: '水族馆开启中',
    tooltipOff: '水族馆已暂停',
  },
  ja: {
    enable: '透明アクアリウムをオンにする',
    disable: '透明アクアリウムを一時停止',
    tooltipOn: 'アクアリウムは表示中',
    tooltipOff: 'アクアリウムは一時停止中',
  },
} as const;

const text = labels[locale];
---

<div class="transparent-aquarium" data-aquarium data-locale={locale}>
  <canvas class="transparent-aquarium__canvas" data-aquarium-canvas aria-hidden="true"></canvas>
  <button
    type="button"
    class="transparent-aquarium__toggle ui-tooltip ui-tooltip-left"
    data-aquarium-toggle
    data-label-enable={text.enable}
    data-label-disable={text.disable}
    data-tooltip-on={text.tooltipOn}
    data-tooltip-off={text.tooltipOff}
    data-tooltip={text.tooltipOff}
    aria-label={text.enable}
    aria-pressed="false"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M3.5 12.2c2.2-3 5.3-4.5 9.1-4.5 3.1 0 5.5 1.2 7.4 3.6.4.5.4 1.2 0 1.7-1.9 2.4-4.3 3.6-7.4 3.6-3.8 0-6.9-1.5-9.1-4.4Z" />
      <path d="M3.5 12.2 1.7 9.3c-.2-.4.2-.8.6-.6l3.2 1.5" />
      <path d="M3.5 12.2 1.7 15c-.2.4.2.8.6.6l3.2-1.5" />
      <path d="M14.5 8.1c-.9 1.2-.9 6.9 0 8.1" />
      <path d="M18.5 11.9h.01" />
    </svg>
  </button>
</div>

<script>
  import { initAquarium } from '../lib/aquarium';

  function bootAquarium() {
    document.querySelectorAll('[data-aquarium]').forEach((el) => {
      if (el instanceof HTMLElement) initAquarium(el);
    });
  }

  document.addEventListener('astro:page-load', bootAquarium);
</script>

<style>
  .transparent-aquarium {
    pointer-events: none;
    position: fixed;
    inset: 0;
    z-index: 30;
  }

  .transparent-aquarium__canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
  }

  .transparent-aquarium__toggle {
    pointer-events: auto;
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--theme-border);
    border-radius: 999px;
    color: var(--theme-page-text);
    background: var(--theme-surface-strong);
    box-shadow: var(--theme-shadow);
    backdrop-filter: blur(16px);
    opacity: 0.78;
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .transparent-aquarium__toggle:hover,
  .transparent-aquarium__toggle:focus-visible {
    opacity: 1;
    transform: translateY(-1px);
    border-color: rgba(103, 232, 249, 0.34);
    outline: none;
  }

  .transparent-aquarium__toggle svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .transparent-aquarium.is-active .transparent-aquarium__toggle {
    color: #a5f3fc;
    border-color: rgba(34, 211, 238, 0.3);
    background:
      linear-gradient(135deg, rgba(34, 211, 238, 0.2), rgba(15, 23, 42, 0.78)),
      var(--theme-surface-strong);
  }

  html[data-theme='light'] .transparent-aquarium__toggle {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(250, 250, 249, 0.96)),
      var(--theme-surface-strong);
  }

  html[data-theme='light'] .transparent-aquarium.is-active .transparent-aquarium__toggle {
    color: #0e7490;
    border-color: rgba(14, 116, 144, 0.24);
    background:
      linear-gradient(135deg, rgba(207, 250, 254, 0.82), rgba(255, 255, 255, 0.98)),
      var(--theme-surface-strong);
  }

  @media (max-width: 767px) {
    .transparent-aquarium__toggle {
      width: 2.5rem;
      height: 2.5rem;
    }

    .transparent-aquarium__toggle::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .transparent-aquarium__toggle {
      transition: none;
    }

    .transparent-aquarium__toggle::after {
      transition: none;
    }
  }
</style>
