---
import PostCard from './PostCard.astro';
import {
  articlePath,
  cadenceLabels,
  collectionLabels,
  radarCadences,
  slugifyTag,
  type CollectionName,
  type Locale,
} from '../lib/site';
import { getAcademySeriesGroups, getEntriesForLocale } from '../lib/content';
import { groupByMonth, resolveRadarCadence } from '../lib/radar';
import { categoryPage, formatDate } from '../lib/i18n';

const { locale, category } = Astro.props as {
  locale: Locale;
  category: CollectionName;
};

const entries = await getEntriesForLocale(locale);
const categoryEntries = entries.filter((item) => item.entry.data.category === category);
const isRadar = category === 'radar';
const isAcademy = category === 'academy';
const academySeriesGroups = isAcademy ? await getAcademySeriesGroups(locale) : [];
const legacyAcademyEntries = isAcademy ? categoryEntries.filter((item) => !item.entry.data.academy) : [];

const radarSections = radarCadences.map((cadence) => {
  const items = categoryEntries.filter((item) => resolveRadarCadence(item) === cadence);
  return {
    cadence,
    label: cadenceLabels[cadence][locale],
    items,
    archiveGroups: groupByMonth(items, locale),
  };
});

const text = categoryPage[locale];
---

<section class="theme-panel-strong rounded-[1.5rem] p-8 shadow-glow">
  <p class="theme-kicker text-sm uppercase tracking-[0.28em]">{collectionLabels[category][locale]}</p>
  <h1 class="theme-heading mt-3 text-3xl font-semibold md:text-5xl">{collectionLabels[category][locale]}</h1>
  <p class="theme-muted mt-4 max-w-2xl">{isRadar ? text.radarLead : isAcademy ? text.academyLead : text.lead}</p>

  {isRadar ? (
    <div class="mt-8 flex flex-wrap gap-2">
      {radarSections.map((section) => (
        <a href={`#${section.cadence}`} class="theme-chip theme-chip-link rounded-xl px-4 py-2 text-sm">
          {section.label}
        </a>
      ))}
    </div>
  ) : isAcademy ? (
    <p class="theme-muted mt-8 max-w-xl text-sm">{text.academyBrowse}</p>
  ) : (
    <p class="theme-muted mt-8 max-w-xl text-sm">{text.defaultListNote}</p>
  )}
</section>

<section class="mt-8">
  <div class="mb-5 flex items-end justify-between gap-4">
    <div>
      <p class="theme-muted text-sm uppercase tracking-[0.24em]">{collectionLabels[category][locale]}</p>
      <h2 class="theme-heading mt-2 text-2xl font-semibold">{categoryEntries.length}</h2>
    </div>
    <p class="theme-muted max-w-md text-sm">{isRadar ? text.radarBrowse : isAcademy ? text.academyBrowse : text.browse}</p>
  </div>

  {isRadar ? (
    <div class="grid gap-8">
      {radarSections.map((section) => (
        <section id={section.cadence} class="theme-panel rounded-[1.25rem] p-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{section.label}</p>
              <h3 class="theme-heading mt-2 text-2xl font-semibold">{section.items.length}</h3>
            </div>
            <p class="theme-muted text-sm">{text.radarArchiveNote(section.label)}</p>
          </div>

          {section.items.length > 0 ? (
            <div class="mt-5 grid gap-4">
              {section.archiveGroups.map((group) => (
                <details id={`${section.cadence}-${group.id}`} class="theme-panel-strong rounded-[1rem] p-1" open={group.open}>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-[0.85rem] px-4 py-3">
                    <div>
                      <p class="theme-heading text-base font-semibold">{group.label}</p>
                      <p class="theme-muted mt-1 text-xs uppercase tracking-[0.2em]">
                        {text.radarArchive} · {group.items.length}
                      </p>
                    </div>
                    <span class="theme-muted text-xs">⌄</span>
                  </summary>

                  <div class="grid gap-2 px-2 pb-2 pt-1">
                    {group.items.map((item) => (
                      <a
                        href={articlePath(item.entry.data.category, item.slug, locale)}
                        class="theme-button-soft rounded-[0.9rem] px-4 py-3"
                      >
                        <div class="flex items-start justify-between gap-4">
                          <div class="min-w-0">
                            <p class="theme-heading line-clamp-2 text-sm font-semibold leading-6">{item.entry.data.title}</p>
                            <div class="mt-2 flex flex-wrap gap-2">
                              {item.entry.data.tags.slice(0, 3).map((tag) => (
                                <span class="theme-chip rounded-xl px-2 py-1 text-[11px]">{tag}</span>
                              ))}
                            </div>
                          </div>
                          <p class="theme-muted shrink-0 text-xs uppercase tracking-[0.2em]">
                            {formatDate(item.entry.data.date, locale)}
                          </p>
                        </div>
                      </a>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          ) : (
            <div class="theme-panel mt-5 rounded-2xl border-dashed p-6 theme-muted">{text.radarEmpty}</div>
          )}
        </section>
      ))}
    </div>
  ) : isAcademy ? (
    <div class="grid gap-8">
      {academySeriesGroups.map((seriesGroup) => (
        <section id={slugifyTag(seriesGroup.series)} class="theme-panel rounded-[1.5rem] p-6">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{text.academySeries}</p>
              <h3 class="theme-heading mt-2 text-3xl font-semibold">{seriesGroup.series}</h3>
            </div>
            <p class="theme-muted text-sm">{text.moduleCount(seriesGroup.modules.length)}</p>
          </div>

          <div class="mt-6 grid gap-5">
            {seriesGroup.modules.map((moduleGroup) => (
              <section
                id={`${slugifyTag(seriesGroup.series)}-${slugifyTag(moduleGroup.name)}`}
                class="theme-panel-strong rounded-[1.25rem] p-5"
              >
                <div class="flex flex-wrap items-end justify-between gap-4">
                  <div>
                    <p class="theme-muted text-xs uppercase tracking-[0.24em]">
                      {text.academyModule} {moduleGroup.order}
                    </p>
                    <h4 class="theme-heading mt-2 text-2xl font-semibold">{moduleGroup.name}</h4>
                  </div>
                  <p class="theme-muted text-sm">{text.itemCount(moduleGroup.items.length)}</p>
                </div>

                <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                  {moduleGroup.items.map((item) => <PostCard item={item} locale={locale} />)}
                </div>
              </section>
            ))}
          </div>
        </section>
      ))}

      {legacyAcademyEntries.length > 0 ? (
        <section class="theme-panel rounded-[1.5rem] p-6">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="theme-muted text-xs uppercase tracking-[0.24em]">{text.academyLegacy}</p>
              <h3 class="theme-heading mt-2 text-2xl font-semibold">{text.academyLegacy}</h3>
            </div>
            <p class="theme-muted text-sm">{text.itemCount(legacyAcademyEntries.length)}</p>
          </div>

          <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {legacyAcademyEntries.map((item) => <PostCard item={item} locale={locale} />)}
          </div>
        </section>
      ) : null}

      {academySeriesGroups.length === 0 && legacyAcademyEntries.length === 0 ? (
        <div class="theme-panel rounded-2xl p-6 theme-muted">{text.empty}</div>
      ) : null}
    </div>
  ) : (
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {categoryEntries.length > 0 ? (
        categoryEntries.map((item) => <PostCard item={item} locale={locale} />)
      ) : (
        <div class="theme-panel rounded-2xl p-6 theme-muted">{text.empty}</div>
      )}
    </div>
  )}
</section>
