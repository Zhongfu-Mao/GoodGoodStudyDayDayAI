---
import PostCard from './PostCard.astro';
import RadarVisualCard from './RadarVisualCard.astro';
import {
  cadenceLabels,
  collectionLabels,
  radarCadences,
  slugifyTag,
  type CollectionName,
  type Locale,
} from '../lib/site';
import { getAcademyCatalogGroups, getEntriesForLocale } from '../lib/content';
import { resolveRadarCadence } from '../lib/radar';
import { categoryPage } from '../lib/i18n';

const { locale, category } = Astro.props as {
  locale: Locale;
  category: CollectionName;
};

const entries = await getEntriesForLocale(locale);
type EntryListItem = (typeof entries)[number];

const academyLearningRouteSeries = 'AI Academy Learning Routes';
const sortByAcademyOrder = (a: EntryListItem, b: EntryListItem) => {
  const aOrder = a.entry.data.academy?.moduleOrder ?? Number.MAX_SAFE_INTEGER;
  const bOrder = b.entry.data.academy?.moduleOrder ?? Number.MAX_SAFE_INTEGER;

  return aOrder - bOrder || a.entry.data.title.localeCompare(b.entry.data.title, locale === 'ja' ? 'ja' : 'zh-Hans');
};

const categoryEntries = entries.filter((item) => item.entry.data.category === category);
const isRadar = category === 'radar';
const isAcademy = category === 'academy';
const academyCatalogGroups = isAcademy
  ? (await getAcademyCatalogGroups(locale)).filter((group) => group.series !== academyLearningRouteSeries)
  : [];
const academyRouteEntries = isAcademy
  ? categoryEntries
      .filter((item) => item.entry.data.academy?.series === academyLearningRouteSeries)
      .sort(sortByAcademyOrder)
  : [];
const legacyAcademyEntries = isAcademy ? categoryEntries.filter((item) => !item.entry.data.academy) : [];

const radarSections = radarCadences.map((cadence) => {
  const items = categoryEntries.filter((item) => resolveRadarCadence(item) === cadence);
  return {
    cadence,
    label: cadenceLabels[cadence][locale],
    items,
  };
});

const text = categoryPage[locale];

const formatAcademyGroupOrder = (groupKind: 'track' | 'module', order: number) =>
  groupKind === 'track' ? order.toString().padStart(2, '0') : order.toString();
---

{isRadar ? (
  null
) : (
  <section class="theme-panel-strong rounded-[1.5rem] p-8 shadow-glow">
    <p class="theme-kicker text-sm uppercase tracking-[0.28em]">{collectionLabels[category][locale]}</p>
    <h1 class="theme-heading mt-3 text-3xl font-semibold md:text-5xl">{collectionLabels[category][locale]}</h1>
    <p class="theme-muted mt-4 max-w-2xl">{isAcademy ? text.academyLead : text.lead}</p>

    {isAcademy ? (
      <p class="theme-muted mt-8 max-w-xl text-sm">{text.academyBrowse}</p>
    ) : (
      <p class="theme-muted mt-8 max-w-xl text-sm">{text.defaultListNote}</p>
    )}
  </section>
)}

<section class="mt-8">
  {!isRadar ? (
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <p class="theme-muted text-sm uppercase tracking-[0.24em]">{collectionLabels[category][locale]}</p>
        <h2 class="theme-heading mt-2 text-2xl font-semibold">{categoryEntries.length}</h2>
      </div>
      <p class="theme-muted max-w-md text-sm">{isAcademy ? text.academyBrowse : text.browse}</p>
    </div>
  ) : null}

  {isRadar ? (
    <div class="relative left-1/2 w-screen max-w-[1680px] -translate-x-1/2 px-5 sm:px-8" data-radar-view>
      {radarSections.map((section) => (
        <section id={section.cadence} class="scroll-mt-80 xl:scroll-mt-40" data-radar-section hidden={section.cadence !== 'daily'}>
          <div class="mb-4">
            <div>
              <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{section.label}</p>
              <h1 class="theme-heading mt-2 text-2xl font-semibold">
                {text.itemCount(section.items.length)}
              </h1>
            </div>
          </div>

          {section.items.length > 0 ? (
            <div class="grid items-start gap-4 md:grid-cols-2">
              {section.items.map((item) => (
                <RadarVisualCard item={item} locale={locale} />
              ))}
            </div>
          ) : (
            <div class="theme-panel rounded-2xl border-dashed p-6 theme-muted">{text.radarEmpty}</div>
          )}
        </section>
      ))}
    </div>
  ) : isAcademy ? (
    <div class="grid gap-8">
      {academyRouteEntries.length > 0 ? (
        <section class="theme-panel-strong rounded-[1.5rem] p-6 shadow-glow">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{text.academyRoutesEyebrow}</p>
              <h3 class="theme-heading mt-2 text-3xl font-semibold">{text.academyRoutesTitle}</h3>
              <p class="theme-muted mt-3 max-w-3xl text-sm leading-6">{text.academyRoutesDescription}</p>
            </div>
            <p class="theme-muted text-sm">{text.itemCount(academyRouteEntries.length)}</p>
          </div>

          <div class="mt-6 grid gap-5 md:grid-cols-3">
            {academyRouteEntries.map((item) => <PostCard item={item} locale={locale} />)}
          </div>
        </section>
      ) : null}

      {academyCatalogGroups.map((seriesGroup) => (
        <section id={slugifyTag(seriesGroup.series)} class="theme-panel rounded-[1.5rem] p-6">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{text.academySeries}</p>
              <h3 class="theme-heading mt-2 text-3xl font-semibold">{seriesGroup.series}</h3>
            </div>
            <p class="theme-muted text-sm">
              {seriesGroup.groupKind === 'track' ? text.trackCount(seriesGroup.groups.length) : text.moduleCount(seriesGroup.groups.length)}
              {' · '}
              {text.itemCount(seriesGroup.itemCount)}
            </p>
          </div>

          <div class="mt-6 grid gap-5">
            {seriesGroup.groups.map((moduleGroup) => (
              <section
                id={`${slugifyTag(seriesGroup.series)}-${slugifyTag(moduleGroup.name)}`}
                class="theme-panel-strong rounded-[1.25rem] p-5"
              >
                <div class="flex flex-wrap items-end justify-between gap-4">
                  <div>
                    <p class="theme-muted text-xs uppercase tracking-[0.24em]">
                      {seriesGroup.groupKind === 'track' ? text.academyTrack : text.academyModule}
                      {' '}
                      {formatAcademyGroupOrder(seriesGroup.groupKind, moduleGroup.order)}
                    </p>
                    <h4 class="theme-heading mt-2 text-2xl font-semibold">{moduleGroup.name}</h4>
                  </div>
                  <p class="theme-muted text-sm">{text.itemCount(moduleGroup.items.length)}</p>
                </div>

                <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                  {moduleGroup.items.map((item) => <PostCard item={item} locale={locale} />)}
                </div>
              </section>
            ))}
          </div>
        </section>
      ))}

      {legacyAcademyEntries.length > 0 ? (
        <section class="theme-panel rounded-[1.5rem] p-6">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="theme-muted text-xs uppercase tracking-[0.24em]">{text.academyLegacy}</p>
              <h3 class="theme-heading mt-2 text-2xl font-semibold">{text.academyLegacy}</h3>
            </div>
            <p class="theme-muted text-sm">{text.itemCount(legacyAcademyEntries.length)}</p>
          </div>

          <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {legacyAcademyEntries.map((item) => <PostCard item={item} locale={locale} />)}
          </div>
        </section>
      ) : null}

      {academyCatalogGroups.length === 0 && legacyAcademyEntries.length === 0 ? (
        <div class="theme-panel rounded-2xl p-6 theme-muted">{text.empty}</div>
      ) : null}
    </div>
  ) : (
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {categoryEntries.length > 0 ? (
        categoryEntries.map((item) => <PostCard item={item} locale={locale} />)
      ) : (
        <div class="theme-panel rounded-2xl p-6 theme-muted">{text.empty}</div>
      )}
    </div>
  )}
</section>

{isRadar ? (
  <script is:inline data-astro-rerun>
    (() => {
      const root = document.querySelector('[data-radar-view]');
      if (!root) return;

      const sections = Array.from(root.querySelectorAll('[data-radar-section]'));
      const validIds = new Set(sections.map((section) => section.id));
      const subnavLinks = Array.from(document.querySelectorAll('[data-radar-subnav]'));
      const abortController = new AbortController();

      function getActiveId() {
        const id = window.location.hash.replace(/^#/, '');
        return validIds.has(id) ? id : 'daily';
      }

      function applyRadarView() {
        const activeId = getActiveId();

        for (const section of sections) {
          section.hidden = section.id !== activeId;
        }

        for (const link of subnavLinks) {
          const target = link.dataset.radarSubnav?.replace(/^#/, '');
          const isActive = target === activeId;
          link.classList.toggle('theme-segment-active', isActive);
          if (target) {
            link.setAttribute('aria-current', isActive ? 'page' : 'false');
          }
        }
      }

      function handleSubnavClick(event) {
        const target = event.currentTarget?.dataset.radarSubnav;
        if (!target) return;

        event.preventDefault();

        if (window.location.hash !== target) {
          window.history.pushState(null, '', target);
        }

        applyRadarView();
      }

      window.addEventListener('hashchange', applyRadarView, { signal: abortController.signal });
      window.addEventListener('popstate', applyRadarView, { signal: abortController.signal });

      for (const link of subnavLinks) {
        link.addEventListener('click', handleSubnavClick, { signal: abortController.signal });
      }

      document.addEventListener('astro:before-swap', () => abortController.abort(), { once: true });
      applyRadarView();
    })();
  </script>
) : null}
