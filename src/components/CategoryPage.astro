---
import PostCard from './PostCard.astro';
import RadarVisualCard from './RadarVisualCard.astro';
import {
  articlePath,
  cadenceLabels,
  collectionLabels,
  radarCadences,
  radarGalleryPath,
  resolveSiteUrl,
  slugifyTag,
  type CollectionName,
  type Locale,
} from '../lib/site';
import { getAcademyCatalogGroups, getEntriesForLocale, getTagIndex } from '../lib/content';
import { resolveRadarCadence } from '../lib/radar';
import { categoryPage } from '../lib/i18n';

const { locale, category } = Astro.props as {
  locale: Locale;
  category: CollectionName;
};

const entries = await getEntriesForLocale(locale);
type EntryListItem = (typeof entries)[number];

const academyLearningRouteSeries = 'AI Academy Learning Routes';
const sortByAcademyOrder = (a: EntryListItem, b: EntryListItem) => {
  const aOrder = a.entry.data.academy?.moduleOrder ?? Number.MAX_SAFE_INTEGER;
  const bOrder = b.entry.data.academy?.moduleOrder ?? Number.MAX_SAFE_INTEGER;

  return aOrder - bOrder || a.entry.data.title.localeCompare(b.entry.data.title, locale === 'ja' ? 'ja' : 'zh-Hans');
};

const categoryEntries = entries.filter((item) => item.entry.data.category === category);
const isRadar = category === 'radar';
const isAcademy = category === 'academy';
const isFilterableCategory = category === 'engineering' || category === 'foundations';
const publicTagSlugs = new Set((await getTagIndex(locale)).map((tag) => tag.slug));
const academyCatalogGroups = isAcademy
  ? (await getAcademyCatalogGroups(locale)).filter((group) => group.series !== academyLearningRouteSeries)
  : [];
const academyRouteEntries = isAcademy
  ? categoryEntries
      .filter((item) => item.entry.data.academy?.series === academyLearningRouteSeries)
      .sort(sortByAcademyOrder)
  : [];
const legacyAcademyEntries = isAcademy ? categoryEntries.filter((item) => !item.entry.data.academy) : [];

const radarSections = radarCadences.map((cadence) => {
  const items = categoryEntries.filter(
    (item) => resolveRadarCadence(item) === cadence && item.entry.data.includeInRadarArchive,
  );
  return {
    cadence,
    label: cadenceLabels[cadence][locale],
    items,
  };
});

const text = categoryPage[locale];
const collectionLead = isFilterableCategory ? text.collectionLead[category] : undefined;
const categoryFilterCounts = new Map<string, { label: string; count: number }>();
if (isFilterableCategory) {
  for (const item of categoryEntries) {
    for (const tag of item.entry.data.tags) {
      const slug = slugifyTag(tag);
      if (!publicTagSlugs.has(slug)) continue;

      const current = categoryFilterCounts.get(slug);
      categoryFilterCounts.set(slug, { label: current?.label ?? tag, count: (current?.count ?? 0) + 1 });
    }
  }
}
const categoryFilters = [...categoryFilterCounts.entries()]
  .map(([slug, value]) => ({ slug, ...value }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, locale === 'ja' ? 'ja' : 'zh-Hans'))
  .slice(0, 10);
const getCategoryCardTagData = (item: EntryListItem) =>
  `|${item.entry.data.tags.map((tag) => slugifyTag(tag)).filter((slug) => publicTagSlugs.has(slug)).join('|')}|`;
const radarCardCounts = Object.fromEntries(
  radarSections.map((section) => [section.cadence, section.items.length]),
) as Record<(typeof radarSections)[number]['cadence'], number>;
const radarGalleryCount = isRadar
  ? categoryEntries.filter((item) => item.entry.data.coverImage).length
  : 0;
const radarPodcastCover = isRadar ? resolveSiteUrl('/images/podcast-cover-ai-radar-20260510.jpg') : '';
const radarHubItems = isRadar
  ? [
      {
        key: 'daily',
        title: text.radarHubCards.daily.title,
        description: text.radarHubCards.daily.description,
        href: '#daily',
        count: radarCardCounts.daily,
      },
      {
        key: 'weekly',
        title: text.radarHubCards.weekly.title,
        description: text.radarHubCards.weekly.description,
        href: '#weekly',
        count: radarCardCounts.weekly,
      },
      {
        key: 'monthly',
        title: text.radarHubCards.monthly.title,
        description: text.radarHubCards.monthly.description,
        href: '#monthly',
        count: radarCardCounts.monthly,
      },
      {
        key: 'gallery',
        title: text.radarHubCards.gallery.title,
        description: text.radarHubCards.gallery.description,
        href: radarGalleryPath(locale),
        count: radarGalleryCount,
      },
    ]
  : [];
const academySummary = isAcademy
  ? {
      eyebrow: text.academyRoutesEyebrow,
      title: text.academyRoutesTitle,
      description: text.academyRoutesDescription,
      detail: text.academyBrowse,
    }
  : undefined;

const formatAcademyGroupOrder = (groupKind: 'track' | 'module', order: number) =>
  groupKind === 'track' ? order.toString().padStart(2, '0') : order.toString();
---

{isRadar ? (
  null
) : (
  <section class="theme-panel-strong rounded-[1.5rem] p-8 shadow-glow" data-academy-summary={isAcademy ? 'true' : undefined}>
    <p class="theme-kicker text-sm uppercase tracking-[0.28em]" data-academy-summary-eyebrow>
      {academySummary?.eyebrow ?? collectionLabels[category][locale]}
    </p>
    <h1 class="theme-heading mt-3 text-3xl font-semibold md:text-5xl" data-academy-summary-title>
      {academySummary?.title ?? collectionLabels[category][locale]}
    </h1>
    <p class="theme-muted mt-4 max-w-2xl" data-academy-summary-description>
      {academySummary?.description ?? (isAcademy ? text.academyLead : (collectionLead ?? text.lead))}
    </p>

    {isAcademy ? (
      <p class="theme-muted mt-8 max-w-xl text-sm" data-academy-summary-detail>{academySummary?.detail}</p>
    ) : (
      <p class="theme-muted mt-8 max-w-xl text-sm">{text.defaultListNote}</p>
    )}
  </section>
)}

<section class={isRadar ? 'mt-0' : 'mt-8'}>
  {!isRadar ? (
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <p class="theme-muted text-sm uppercase tracking-[0.24em]">{collectionLabels[category][locale]}</p>
        <h2 class="theme-heading mt-2 text-2xl font-semibold">{text.collectionBrowseTitle(collectionLabels[category][locale], categoryEntries.length)}</h2>
      </div>
      <p class="theme-muted max-w-md text-sm">{isAcademy ? text.academyBrowse : text.browse}</p>
    </div>
  ) : null}

  {isRadar ? (
    <div class="relative left-1/2 w-screen max-w-[1680px] -translate-x-1/2 px-5 sm:px-8" data-radar-view>
      <section class="radar-hub-stage relative mb-5 grid overflow-hidden rounded-[1.5rem] p-5 shadow-glow md:p-7 lg:min-h-[calc(100vh-14rem)] lg:grid-cols-[minmax(0,0.9fr)_minmax(20rem,0.72fr)] lg:items-center lg:gap-10 xl:px-10" data-radar-hub>
        <div class="radar-hub-copy relative z-10 max-w-3xl lg:self-start lg:pt-12 xl:pt-16">
          <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{collectionLabels.radar[locale]}</p>
          <h1 class="theme-heading mt-4 text-5xl font-semibold leading-none md:text-7xl xl:text-8xl">
            {text.radarHubTitle}
          </h1>
          <p class="theme-muted mt-5 max-w-2xl text-sm leading-6 md:text-base md:leading-7">{text.radarHubDescription}</p>

          <div class="radar-hub-actions mt-8 grid max-w-xl gap-3 rounded-[1.1rem] border p-3 sm:grid-cols-2 lg:min-h-[15.75rem] lg:auto-rows-fr" aria-label={text.radarHubTitle}>
            {radarHubItems.map((item) => (
              <a
                href={item.href}
                class="radar-entry-link group flex min-h-[5.15rem] items-center justify-between gap-3 rounded-[0.95rem] border px-4 py-3.5 text-sm font-semibold transition duration-200 hover:-translate-y-0.5"
                data-radar-hub-card={item.key}
              >
                <span class="min-w-0">
                  <span class="block truncate">{item.key === 'gallery' ? text.radarGallery : item.title}</span>
                  <span class="mt-1 block text-[color:var(--theme-accent)]">{text.itemCount(item.count)}</span>
                </span>
                <span aria-hidden="true">-&gt;</span>
              </a>
            ))}
          </div>
        </div>

        <figure class="radar-cover-frame relative z-10 mx-auto mt-8 w-full max-w-[31rem] lg:mt-0 xl:max-w-[35rem]">
          <div class="radar-cover-glow" aria-hidden="true"></div>
          <img
            src={radarPodcastCover}
            alt={text.radarHubTitle}
            class="relative z-10 aspect-square w-full rounded-[1.15rem] object-cover shadow-2xl"
            loading="eager"
          />
        </figure>
      </section>

      {radarSections.map((section) => (
        <section id={section.cadence} class="scroll-mt-80 xl:scroll-mt-40" data-radar-section role="tabpanel" hidden>
          <div class="mb-3">
            <div>
              <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{section.label}</p>
              <h2 class="theme-heading mt-1.5 text-2xl font-semibold">{text.radarSectionTitle[section.cadence]}</h2>
              <p class="theme-muted mt-1.5 text-sm">{text.itemCount(section.items.length)}</p>
            </div>
          </div>

          {section.items.length > 0 ? (
            <div class="grid items-stretch gap-3 md:grid-cols-2">
              {section.items.map((item) => (
                <RadarVisualCard item={item} locale={locale} />
              ))}
            </div>
          ) : (
            <div class="theme-panel rounded-2xl border-dashed p-6 theme-muted">{text.radarEmpty}</div>
          )}
        </section>
      ))}
    </div>
  ) : isAcademy ? (
    <div class="grid gap-8" data-academy-view>
      {academyRouteEntries.length > 0 ? (
        <section
          id="routes"
          class="theme-panel-strong rounded-[1.5rem] p-6 shadow-glow scroll-mt-80 xl:scroll-mt-40"
          data-academy-section
          role="tabpanel"
          data-academy-eyebrow={text.academyRoutesEyebrow}
          data-academy-title={text.academyRoutesTitle}
          data-academy-description={text.academyRoutesDescription}
          data-academy-detail={text.academyBrowse}
        >
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{text.academyRoutesEyebrow}</p>
              <h3 class="theme-heading mt-2 text-3xl font-semibold">{text.academyRoutesTitle}</h3>
              <p class="theme-muted mt-3 max-w-3xl text-sm leading-6">{text.academyRoutesDescription}</p>
            </div>
            <p class="theme-muted text-sm">{text.itemCount(academyRouteEntries.length)}</p>
          </div>

          <div class="mt-6 grid gap-5 md:grid-cols-3">
            {academyRouteEntries.map((item) => <PostCard item={item} locale={locale} />)}
          </div>
        </section>
      ) : null}

      {academyCatalogGroups.map((seriesGroup) => (
        <section
          id={slugifyTag(seriesGroup.series)}
          class="theme-panel rounded-[1.5rem] p-6 scroll-mt-80 xl:scroll-mt-40"
          data-academy-section
          role="tabpanel"
          data-academy-eyebrow={text.academySeries}
          data-academy-title={seriesGroup.series}
          data-academy-description={text.academySeriesDescription(seriesGroup.series)}
          data-academy-detail={`${seriesGroup.groupKind === 'track' ? text.trackCount(seriesGroup.groups.length) : text.moduleCount(seriesGroup.groups.length)} · ${text.itemCount(seriesGroup.itemCount)}`}
          hidden
        >
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{text.academySeries}</p>
              <h3 class="theme-heading mt-2 text-3xl font-semibold">{seriesGroup.series}</h3>
              <p class="theme-muted mt-3 max-w-3xl text-sm leading-6">{text.academySeriesDescription(seriesGroup.series)}</p>
            </div>
            <div class="flex flex-col items-end gap-3 text-sm">
              <p class="theme-muted">
                {seriesGroup.groupKind === 'track' ? text.trackCount(seriesGroup.groups.length) : text.moduleCount(seriesGroup.groups.length)}
                {' · '}
                {text.itemCount(seriesGroup.itemCount)}
              </p>
              {seriesGroup.groups[0]?.items[0] ? (
                <a
                  href={articlePath(
                    seriesGroup.groups[0].items[0].entry.data.category,
                    seriesGroup.groups[0].items[0].slug,
                    locale,
                  )}
                  class="theme-action-primary inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold"
                  data-academy-start-reading
                  aria-label={`${text.academyStartReading}: ${seriesGroup.series}`}
                >
                  <span>{text.academyStartReading}</span>
                  <span aria-hidden="true">→</span>
                </a>
              ) : null}
            </div>
          </div>

          <div class="mt-6 grid gap-5">
            {seriesGroup.groups.map((moduleGroup) => (
              <section
                id={`${slugifyTag(seriesGroup.series)}-${slugifyTag(moduleGroup.name)}`}
                class="theme-panel-strong rounded-[1.25rem] p-5"
              >
                <div class="flex flex-wrap items-end justify-between gap-4">
                  <div>
                    <p class="theme-muted text-xs uppercase tracking-[0.24em]">
                      {seriesGroup.groupKind === 'track' ? text.academyTrack : text.academyModule}
                      {' '}
                      {formatAcademyGroupOrder(seriesGroup.groupKind, moduleGroup.order)}
                    </p>
                    <h4 class="theme-heading mt-2 text-2xl font-semibold">{moduleGroup.name}</h4>
                  </div>
                  <p class="theme-muted text-sm">{text.itemCount(moduleGroup.items.length)}</p>
                </div>

                <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                  {moduleGroup.items.map((item) => <PostCard item={item} locale={locale} />)}
                </div>
              </section>
            ))}
          </div>
        </section>
      ))}

      {legacyAcademyEntries.length > 0 ? (
        <section
          id="other-academy"
          class="theme-panel rounded-[1.5rem] p-6 scroll-mt-80 xl:scroll-mt-40"
          data-academy-section
          role="tabpanel"
          data-academy-eyebrow={text.academyLegacy}
          data-academy-title={text.academyLegacy}
          data-academy-description={text.academyLegacyDescription}
          data-academy-detail={text.itemCount(legacyAcademyEntries.length)}
          hidden
        >
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="theme-muted text-xs uppercase tracking-[0.24em]">{text.academyLegacy}</p>
              <h3 class="theme-heading mt-2 text-2xl font-semibold">{text.academyLegacy}</h3>
              <p class="theme-muted mt-3 max-w-3xl text-sm leading-6">{text.academyLegacyDescription}</p>
            </div>
            <p class="theme-muted text-sm">{text.itemCount(legacyAcademyEntries.length)}</p>
          </div>

          <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {legacyAcademyEntries.map((item) => <PostCard item={item} locale={locale} />)}
          </div>
        </section>
      ) : null}

      {academyCatalogGroups.length === 0 && legacyAcademyEntries.length === 0 ? (
        <div class="theme-panel rounded-2xl p-6 theme-muted">{text.empty}</div>
      ) : null}
    </div>
  ) : (
    <div>
      {categoryFilters.length > 0 ? (
        <div class="theme-panel mb-5 rounded-[1.25rem] p-4" data-category-filter-bar>
          <div class="flex flex-wrap items-center gap-2">
            <span class="theme-muted px-1 text-[11px] font-semibold uppercase tracking-[0.18em]">{text.filterEyebrow}</span>
            <button
              type="button"
              class="theme-chip theme-chip-link theme-segment-active rounded-xl px-3 py-1.5 text-xs"
              data-category-filter="all"
              aria-pressed="true"
            >
              {text.filterAll}
            </button>
            {categoryFilters.map((filter) => (
              <button
                type="button"
                class="theme-chip theme-chip-link rounded-xl px-3 py-1.5 text-xs"
                data-category-filter={filter.slug}
                aria-pressed="false"
              >
                {filter.label}
                <span class="ml-1 opacity-70">{text.filterCount(filter.count)}</span>
              </button>
            ))}
          </div>
        </div>
      ) : null}

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3" data-category-grid>
      {categoryEntries.length > 0 ? (
        categoryEntries.map((item) => (
          <div data-category-card data-card-tags={getCategoryCardTagData(item)}>
            <PostCard item={item} locale={locale} />
          </div>
        ))
      ) : (
        <div class="theme-panel rounded-2xl p-6 theme-muted">{text.empty}</div>
      )}
      </div>
    </div>
  )}
</section>

{categoryFilters.length > 0 ? (
  <script is:inline data-astro-rerun>
    (() => {
      const filterButtons = Array.from(document.querySelectorAll('[data-category-filter]'));
      const cards = Array.from(document.querySelectorAll('[data-category-card]'));
      if (filterButtons.length === 0 || cards.length === 0) return;

      const abortController = new AbortController();

      function applyFilter(activeFilter) {
        for (const button of filterButtons) {
          const isActive = button.dataset.categoryFilter === activeFilter;
          button.classList.toggle('theme-segment-active', isActive);
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        }

        for (const card of cards) {
          const cardTags = card.dataset.cardTags ?? '';
          card.hidden = activeFilter !== 'all' && !cardTags.includes(`|${activeFilter}|`);
        }
      }

      for (const button of filterButtons) {
        button.addEventListener(
          'click',
          () => applyFilter(button.dataset.categoryFilter ?? 'all'),
          { signal: abortController.signal },
        );
      }

      document.addEventListener('astro:before-swap', () => abortController.abort(), { once: true });
    })();
  </script>
) : null}

{isRadar ? (
  <script is:inline data-astro-rerun>
    (() => {
      const root = document.querySelector('[data-radar-view]');
      if (!root) return;

      const hub = root.querySelector('[data-radar-hub]');
      const sections = Array.from(root.querySelectorAll('[data-radar-section]'));
      const validIds = new Set(sections.map((section) => section.id));
      const subnavLinks = Array.from(document.querySelectorAll('[data-radar-subnav]'));
      const abortController = new AbortController();

      function getActiveId() {
        const id = window.location.hash.replace(/^#/, '');
        return validIds.has(id) ? id : '';
      }

      function applyRadarView() {
        const activeId = getActiveId();
        const hasActiveSection = Boolean(activeId);
        const visibleId = activeId;

        if (hub) {
          hub.hidden = hasActiveSection;
        }

        for (const section of sections) {
          section.hidden = section.id !== visibleId;
        }

        for (const link of subnavLinks) {
          const target = link.dataset.radarSubnav?.replace(/^#/, '');
          const isActive = Boolean(visibleId) && target === visibleId;
          link.classList.toggle('theme-segment-active', isActive);
          if (target) {
            link.setAttribute('aria-selected', isActive ? 'true' : 'false');
            link.removeAttribute('aria-current');
          }
        }
      }

      function handleSubnavClick(event) {
        const target = event.currentTarget?.dataset.radarSubnav;
        if (!target) return;

        event.preventDefault();

        if (window.location.hash !== target) {
          window.history.pushState(null, '', target);
        }

        applyRadarView();
      }

      window.addEventListener('hashchange', applyRadarView, { signal: abortController.signal });
      window.addEventListener('popstate', applyRadarView, { signal: abortController.signal });

      for (const link of subnavLinks) {
        link.addEventListener('click', handleSubnavClick, { signal: abortController.signal });
      }

      document.addEventListener('astro:before-swap', () => abortController.abort(), { once: true });
      applyRadarView();
    })();
  </script>
) : null}

{isRadar ? (
  <style>
    .radar-hub-stage {
      isolation: isolate;
      border: 1px solid color-mix(in srgb, var(--theme-accent) 22%, var(--theme-border));
      background:
        radial-gradient(circle at 76% 42%, color-mix(in srgb, var(--theme-accent) 23%, transparent), transparent 32rem),
        linear-gradient(135deg, color-mix(in srgb, var(--theme-surface-strong) 96%, transparent), color-mix(in srgb, var(--theme-surface) 72%, transparent));
    }

    .radar-hub-stage::before {
      position: absolute;
      inset: 0;
      z-index: 0;
      content: '';
      background:
        linear-gradient(
          90deg,
          color-mix(in srgb, var(--theme-accent) 8%, transparent) 0 1px,
          transparent 1px 100%
        ),
        linear-gradient(
          0deg,
          color-mix(in srgb, var(--theme-accent) 6%, transparent) 0 1px,
          transparent 1px 100%
        );
      background-size: 5rem 5rem;
      mask-image: linear-gradient(90deg, black 0%, black 70%, transparent 100%);
      opacity: 0.45;
    }

    .radar-hub-stage::after {
      position: absolute;
      inset: 8% -8% -20% 42%;
      z-index: 0;
      content: '';
      background:
        repeating-radial-gradient(
          circle at 55% 42%,
          transparent 0 4.4rem,
          color-mix(in srgb, var(--theme-accent) 22%, transparent) 4.45rem 4.55rem
        ),
        conic-gradient(
          from -34deg at 55% 42%,
          color-mix(in srgb, var(--theme-accent) 24%, transparent) 0deg,
          color-mix(in srgb, var(--theme-accent) 4%, transparent) 34deg,
          transparent 74deg 360deg
        );
      opacity: 0.7;
    }

    .radar-entry-link {
      background: color-mix(in srgb, var(--theme-surface-strong) 82%, transparent);
      border-color: color-mix(in srgb, var(--theme-accent) 24%, var(--theme-border));
    }

    .radar-hub-actions {
      background:
        linear-gradient(135deg, color-mix(in srgb, var(--theme-accent) 9%, transparent), transparent),
        color-mix(in srgb, var(--theme-surface-strong) 72%, transparent);
      border-color: color-mix(in srgb, var(--theme-accent) 24%, var(--theme-border));
      box-shadow: inset 0 1px 0 color-mix(in srgb, white 8%, transparent);
      backdrop-filter: blur(14px);
    }

    .radar-entry-link:hover {
      background: color-mix(in srgb, var(--theme-accent) 14%, var(--theme-surface-strong));
      border-color: color-mix(in srgb, var(--theme-accent) 54%, var(--theme-border));
    }

    .radar-cover-frame {
      filter: drop-shadow(0 2rem 4rem color-mix(in srgb, var(--theme-accent) 20%, transparent));
    }

    .radar-cover-glow {
      position: absolute;
      inset: -7%;
      z-index: 0;
      border-radius: 1.6rem;
      background:
        radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--theme-accent) 34%, transparent), transparent 58%),
        linear-gradient(135deg, color-mix(in srgb, var(--theme-accent) 18%, transparent), transparent);
      opacity: 0.85;
      filter: blur(12px);
    }

    html[data-theme='light'] .radar-hub-stage {
      background:
        radial-gradient(circle at 76% 42%, color-mix(in srgb, var(--theme-accent) 18%, transparent), transparent 32rem),
        linear-gradient(135deg, color-mix(in srgb, var(--theme-surface-strong) 98%, transparent), color-mix(in srgb, var(--theme-surface) 86%, transparent));
    }
  </style>
) : null}

{isAcademy ? (
  <script is:inline data-astro-rerun>
    (() => {
      const root = document.querySelector('[data-academy-view]');
      if (!root) return;

      const sections = Array.from(root.querySelectorAll('[data-academy-section]'));
      const validIds = new Set(sections.map((section) => section.id));
      const subnavLinks = Array.from(document.querySelectorAll('[data-academy-subnav]'));
      const summary = document.querySelector('[data-academy-summary]');
      const summaryEyebrow = summary?.querySelector('[data-academy-summary-eyebrow]');
      const summaryTitle = summary?.querySelector('[data-academy-summary-title]');
      const summaryDescription = summary?.querySelector('[data-academy-summary-description]');
      const summaryDetail = summary?.querySelector('[data-academy-summary-detail]');
      const fallbackId = validIds.has('routes') ? 'routes' : sections[0]?.id;
      const abortController = new AbortController();

      if (!fallbackId) return;

      function getActiveId() {
        const id = window.location.hash.replace(/^#/, '');
        return validIds.has(id) ? id : fallbackId;
      }

      function applyAcademyView() {
        const activeId = getActiveId();
        const activeSection = sections.find((section) => section.id === activeId);

        for (const section of sections) {
          section.hidden = section.id !== activeId;
        }

        for (const link of subnavLinks) {
          const target = link.dataset.academySubnav?.replace(/^#/, '');
          const isActive = target === activeId;
          link.hidden = target ? !validIds.has(target) : true;
          link.classList.toggle('theme-segment-active', isActive);
          if (target) {
            link.setAttribute('aria-selected', isActive ? 'true' : 'false');
            link.removeAttribute('aria-current');
          }
        }

        if (activeSection) {
          if (summaryEyebrow && activeSection.dataset.academyEyebrow) {
            summaryEyebrow.textContent = activeSection.dataset.academyEyebrow;
          }
          if (summaryTitle && activeSection.dataset.academyTitle) {
            summaryTitle.textContent = activeSection.dataset.academyTitle;
          }
          if (summaryDescription && activeSection.dataset.academyDescription) {
            summaryDescription.textContent = activeSection.dataset.academyDescription;
          }
          if (summaryDetail && activeSection.dataset.academyDetail) {
            summaryDetail.textContent = activeSection.dataset.academyDetail;
          }
        }
      }

      function handleSubnavClick(event) {
        const target = event.currentTarget?.dataset.academySubnav;
        if (!target) return;

        event.preventDefault();

        if (window.location.hash !== target) {
          window.history.pushState(null, '', target);
        }

        applyAcademyView();
      }

      window.addEventListener('hashchange', applyAcademyView, { signal: abortController.signal });
      window.addEventListener('popstate', applyAcademyView, { signal: abortController.signal });

      for (const link of subnavLinks) {
        link.addEventListener('click', handleSubnavClick, { signal: abortController.signal });
      }

      document.addEventListener('astro:before-swap', () => abortController.abort(), { once: true });
      applyAcademyView();
    })();
  </script>
) : null}
