---
import SearchForm from './SearchForm.astro';
import { categoryPath, collectionLabels, collectionNames, homePath, startPath, type Locale } from '../lib/site';
import { siteNav } from '../lib/i18n';

const { locale, showSearch = true } = Astro.props as { locale: Locale; showSearch?: boolean };

const navItems = collectionNames.map((category) => ({
  href: categoryPath(category, locale),
  label: collectionLabels[category][locale],
}));
---

<nav class="flex w-full flex-wrap items-center justify-center gap-2.5 2xl:flex-nowrap">
  <a
    href={homePath(locale)}
    class="theme-panel theme-panel-link inline-flex shrink-0 items-center whitespace-nowrap rounded-2xl px-4 py-2.5 text-[15px] 2xl:px-5"
  >
    {siteNav[locale].home}
  </a>
  <a
    href={startPath(locale)}
    class="theme-panel theme-panel-link inline-flex shrink-0 items-center whitespace-nowrap rounded-2xl px-4 py-2.5 text-[15px] 2xl:px-5"
  >
    {siteNav[locale].start}
  </a>
  {navItems.map((item) => (
    <a
      href={item.href}
      class="theme-panel theme-panel-link inline-flex shrink-0 items-center whitespace-nowrap rounded-2xl px-4 py-2.5 text-[15px] 2xl:px-5"
    >
      {item.label}
    </a>
  ))}
  {showSearch ? <SearchForm locale={locale} /> : null}
</nav>
