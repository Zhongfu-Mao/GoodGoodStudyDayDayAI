---
import type { CollectionEntry } from 'astro:content';
import { articlePath, collectionLabels, resolveSiteUrl, tagPath, type CollectionName, type Locale } from '../lib/site';
import { getPublicTagsForEntry } from '../lib/content';
import { formatDate } from '../lib/i18n';
import { difficultyLabels, estimateReadingMinutes, getEntryDifficulty, readingTimeText } from '../lib/entryMeta';

const { item, locale } = Astro.props as {
  item: {
    collection: CollectionName;
    slug: string;
    entry: CollectionEntry<CollectionName>;
  };
  locale: Locale;
};

const { entry } = item;
const href = articlePath(entry.data.category, item.slug, locale);
const categoryLabel = collectionLabels[entry.data.category][locale];
const coverImageSrc = entry.data.coverImage ? resolveSiteUrl(entry.data.coverImage) : undefined;
const transitionKey = entry.id.replace(/[^A-Za-z0-9_-]/g, '-');
const coverTransitionName = `cover-${transitionKey}`;
const titleTransitionName = `title-${transitionKey}`;
const difficulty = getEntryDifficulty(entry);
const readingMinutes = estimateReadingMinutes(entry.body, locale);
const publicTags = await getPublicTagsForEntry(locale, entry.data.tags);
---

<article class="theme-panel theme-panel-link group rounded-[1.25rem] p-6 shadow-glow">
  {coverImageSrc ? (
    <a
      href={href}
      class="theme-panel-soft relative mb-5 flex h-40 items-center justify-center overflow-hidden rounded-[1rem]"
    >
      <span class="theme-heading text-2xl font-semibold opacity-45" aria-hidden="true">AI</span>
      <img
        src={coverImageSrc}
        alt={entry.data.title}
        transition:name={coverTransitionName}
        class="absolute inset-0 h-full w-full rounded-[1rem] object-cover transition duration-200 group-hover:scale-[1.02]"
        onerror="this.setAttribute('hidden', 'hidden')"
      />
    </a>
  ) : null}

  <div class="theme-muted mb-4 flex items-center justify-between gap-4 text-xs uppercase tracking-[0.2em]">
    <span>{categoryLabel}</span>
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, locale)}</time>
  </div>
  <div class="mb-4 flex flex-wrap gap-2">
    <span class="theme-chip rounded-xl px-3 py-1 text-xs">{difficultyLabels[locale][difficulty]}</span>
    <span class="theme-chip rounded-xl px-3 py-1 text-xs">{readingTimeText[locale](readingMinutes)}</span>
  </div>
  <h3 class="theme-heading text-xl font-semibold transition group-hover:opacity-85" transition:name={titleTransitionName}>
    <a href={href}>{entry.data.title}</a>
  </h3>
  {entry.data.description ? (
    <p class="theme-muted mt-3 line-clamp-3 text-sm leading-6">{entry.data.description}</p>
  ) : null}
  {publicTags.length > 0 ? (
    <div class="mt-4 flex flex-wrap gap-2">
      {publicTags.map((tag) => (
        <a href={tagPath(tag, locale)} class="theme-chip theme-chip-link rounded-xl px-3 py-1 text-xs">
          {tag}
        </a>
      ))}
    </div>
  ) : null}
</article>
