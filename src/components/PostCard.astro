---
import type { CollectionEntry } from 'astro:content';
import { articlePath, collectionLabels, resolveSiteUrl, tagPath, type CollectionName, type Locale } from '../lib/site';
import { formatDate } from '../lib/i18n';

const { item, locale } = Astro.props as {
  item: {
    collection: CollectionName;
    slug: string;
    entry: CollectionEntry<CollectionName>;
  };
  locale: Locale;
};

const { entry } = item;
const href = articlePath(entry.data.category, item.slug, locale);
const categoryLabel = collectionLabels[entry.data.category][locale];
const coverImageSrc = entry.data.coverImage ? resolveSiteUrl(entry.data.coverImage) : undefined;
---

<article class="theme-panel theme-panel-link group rounded-[1.25rem] p-6 shadow-glow">
  {coverImageSrc ? (
    <a href={href} class="mb-5 block overflow-hidden rounded-[1rem]">
      <img
        src={coverImageSrc}
        alt={entry.data.title}
        class="h-40 w-full rounded-[1rem] object-cover transition duration-200 group-hover:scale-[1.02]"
      />
    </a>
  ) : null}

  <div class="theme-muted mb-4 flex items-center justify-between gap-4 text-xs uppercase tracking-[0.2em]">
    <span>{categoryLabel}</span>
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, locale)}</time>
  </div>
  <h3 class="theme-heading text-xl font-semibold transition group-hover:opacity-85">
    <a href={href}>{entry.data.title}</a>
  </h3>
  {entry.data.description ? (
    <p class="theme-muted mt-3 line-clamp-3 text-sm leading-6">{entry.data.description}</p>
  ) : null}
  <div class="mt-4 flex flex-wrap gap-2">
    {entry.data.tags.map((tag) => (
      <a href={tagPath(tag, locale)} class="theme-chip theme-chip-link rounded-xl px-3 py-1 text-xs">
        {tag}
      </a>
    ))}
  </div>
</article>
