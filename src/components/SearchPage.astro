---
import { searchPage } from '../lib/i18n';
import { withBase, type Locale } from '../lib/site';

const { locale } = Astro.props as { locale: Locale };
const text = searchPage[locale];
const pagefindUiCss = withBase('/pagefind/pagefind-ui.css');
const pagefindUiJs = withBase('/pagefind/pagefind-ui.js');
const pagefindBasePath = withBase('/pagefind/');
const clearSearchTooltip = locale === 'ja' ? '検索語をクリア' : '清除搜索关键词';
---

<section class="theme-panel-strong rounded-[1.5rem] p-8 shadow-glow">
  <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{text.title}</p>
  <h1 class="theme-heading mt-3 text-3xl font-semibold">{text.title}</h1>
  <p class="theme-muted mt-4 max-w-2xl">{text.description}</p>
</section>

<section class="theme-panel mt-8 rounded-[1.5rem] p-6">
  <div id="site-search" data-pagefind-ui-root></div>
</section>

<style is:global>
  [data-pagefind-ui-root] {
    color: var(--theme-page-text);
  }

  [data-pagefind-ui-root] .pagefind-ui__search-input,
  [data-pagefind-ui-root] .pagefind-ui__drawer,
  [data-pagefind-ui-root] .pagefind-ui__button {
    background: var(--theme-surface-strong) !important;
    background-image: none !important;
    color: var(--theme-page-text) !important;
    border: 1px solid rgba(103, 232, 249, 0.18) !important;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 12px 36px rgba(2, 6, 23, 0.24) !important;
  }

  [data-pagefind-ui-root] .pagefind-ui__search-input {
    padding-right: 5.25rem !important;
  }

  [data-pagefind-ui-root] .pagefind-ui__search-clear {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 4.5rem !important;
    height: 2.75rem !important;
    padding: 0 1rem !important;
    border-radius: 1rem !important;
    border: 1px solid rgba(103, 232, 249, 0.16) !important;
    background: rgba(255, 255, 255, 0.92) !important;
    color: #111827 !important;
    font-size: 0.95rem !important;
    line-height: 1 !important;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.88),
      0 8px 24px rgba(2, 6, 23, 0.18) !important;
    right: 0.5rem !important;
    top: 0.25rem !important;
    transform: none !important;
  }

  html[data-theme='light'] [data-pagefind-ui-root] .pagefind-ui__search-clear {
    border-color: rgba(214, 171, 92, 0.2) !important;
    background:
      linear-gradient(180deg, rgba(244, 239, 229, 0.96), rgba(239, 232, 220, 0.96)) !important;
    color: #4a3418 !important;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 6px 16px rgba(138, 91, 33, 0.12) !important;
  }

  html[data-theme='light'] [data-pagefind-ui-root] .pagefind-ui__search-input,
  html[data-theme='light'] [data-pagefind-ui-root] .pagefind-ui__drawer,
  html[data-theme='light'] [data-pagefind-ui-root] .pagefind-ui__button {
    border-color: rgba(39, 39, 42, 0.12) !important;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.72),
      0 16px 36px rgba(24, 24, 27, 0.06) !important;
  }

  [data-pagefind-ui-root] .pagefind-ui__search-input::placeholder {
    color: var(--theme-muted) !important;
  }

  [data-pagefind-ui-root] .pagefind-ui__message,
  [data-pagefind-ui-root] .pagefind-ui__result-excerpt,
  [data-pagefind-ui-root] .pagefind-ui__result-nested,
  [data-pagefind-ui-root] .pagefind-ui__result-tags {
    color: var(--theme-muted) !important;
  }

  [data-pagefind-ui-root] .pagefind-ui__result {
    border-top-color: rgba(148, 163, 184, 0.28) !important;
    padding: 1.75rem 1.5rem 2rem !important;
  }

  [data-pagefind-ui-root] .pagefind-ui__results-area,
  [data-pagefind-ui-root] .pagefind-ui__result-inner {
    padding-left: 1.5rem !important;
    padding-right: 1.5rem !important;
    box-sizing: border-box !important;
  }

  [data-pagefind-ui-root] .pagefind-ui__result-link,
  [data-pagefind-ui-root] .pagefind-ui__result-link:visited,
  [data-pagefind-ui-root] .pagefind-ui__result-link:hover,
  [data-pagefind-ui-root] .pagefind-ui__result-link:focus-visible,
  [data-pagefind-ui-root] .pagefind-ui__result-title,
  [data-pagefind-ui-root] .pagefind-ui__result-link .pagefind-ui__result-title {
    color: var(--theme-page-text) !important;
    font-weight: 600 !important;
  }

  [data-pagefind-ui-root] .pagefind-ui__result-link:hover,
  [data-pagefind-ui-root] .pagefind-ui__result-link:focus-visible {
    color: var(--theme-accent) !important;
  }

  [data-pagefind-ui-root] mark {
    background: rgba(250, 204, 21, 0.92);
    color: #18181b;
    border-radius: 0.3rem;
    padding: 0 0.18rem;
  }

  html[data-theme='light'] [data-pagefind-ui-root] mark {
    background: rgba(214, 171, 92, 0.26);
    color: #2a1f14;
  }
</style>

<link rel="stylesheet" href={pagefindUiCss} />
<script
  is:inline
  data-astro-rerun
  define:vars={{
    language: locale,
    placeholder: text.placeholder,
    zeroResults: text.zeroResults,
    pagefindUiJs,
    pagefindBasePath,
    clearSearchTooltip,
  }}
>
  (function () {
    function applySearchTooltips(root) {
      window.requestAnimationFrame(function () {
        var clearButton = root.querySelector('.pagefind-ui__search-clear');

        if (clearButton) {
          clearButton.classList.add('ui-tooltip', 'ui-tooltip-left');
          clearButton.setAttribute('aria-label', clearSearchTooltip);
          clearButton.setAttribute('data-tooltip', clearSearchTooltip);
        }
      });
    }

    function applyInitialQuery(root) {
      var query = new URLSearchParams(window.location.search).get('q');

      if (!query) {
        return;
      }

      window.requestAnimationFrame(function () {
        var input = root.querySelector('input');

        if (!input || input.value === query) {
          return;
        }

        input.value = query;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
    }

    function initSearch() {
      if (typeof window.PagefindUI !== 'function') {
        return;
      }

      var root = document.querySelector('[data-pagefind-ui-root]');

      if (!root || root.dataset.pagefindReady === 'true') {
        return;
      }

      root.dataset.pagefindReady = 'true';

      new window.PagefindUI({
        element: root,
        bundlePath: pagefindBasePath,
        showImages: false,
        showSubResults: true,
        resetStyles: false,
        processTerm: function (term) {
          return term;
        },
        translations: {
          placeholder: placeholder,
          zero_results: zeroResults,
        },
      });

      applyInitialQuery(root);
      applySearchTooltips(root);
    }

    function loadPagefind() {
      if (document.getElementById('pagefind-ui-script')) {
        initSearch();
        return;
      }

      var script = document.createElement('script');
      script.id = 'pagefind-ui-script';
      script.src = pagefindUiJs;
      script.onload = initSearch;
      document.head.appendChild(script);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadPagefind, { once: true });
    } else {
      loadPagefind();
    }
  })();
</script>
