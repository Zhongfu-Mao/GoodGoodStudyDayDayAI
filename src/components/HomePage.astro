---
import { Image } from 'astro:assets';
import {
  articlePath,
  categoryPath,
  collectionLabels,
  primaryCategoryNames,
  radarGalleryPath,
  resolveSiteUrl,
  slugifyTag,
  startPath,
  tagIndexPath,
  tagPath,
  topicIndexPath,
  topicPath,
  type Locale,
} from '../lib/site';
import { getEntriesForLocale, getTagIndex, getTopicIndex } from '../lib/content';
import { formatDate, homePage, topicCopy, topicsPage } from '../lib/i18n';
import TransparentAquarium from './TransparentAquarium.astro';

const { locale } = Astro.props as { locale: Locale };
const entries = await getEntriesForLocale(locale);
const recentStories = entries.slice(0, 6);
const recommendedStory = recentStories[0];
const recentVisualStories = entries
  .filter((item) => item.entry.data.category === 'radar' && item.entry.data.coverImage)
  .slice(0, 3);
const tagIndex = await getTagIndex(locale);
const publicTagSlugs = new Set(tagIndex.map((tag) => tag.slug));
const topicIndex = await getTopicIndex(locale);
const topicCopyByLocale = topicCopy[locale];
const topicsText = topicsPage[locale];
const text = homePage[locale];
const visualCount = entries.filter((item) => item.entry.data.category === 'radar' && item.entry.data.coverImage).length;
const startHref = startPath(locale);
const routeItems = primaryCategoryNames.map((category) => ({
  category,
  href: categoryPath(category, locale),
  title: text.routes[category].title,
  description: text.routes[category].description,
  count: entries.filter((item) => item.entry.data.category === category).length,
}));
const radarPath = categoryPath('radar', locale);
const rssHref = resolveSiteUrl(locale === 'ja' ? '/ja/rss.xml' : '/rss.xml');
const intentItems = [
  {
    ...text.intentItems.beginner,
    href: startHref,
  },
  {
    ...text.intentItems.radar,
    href: radarPath,
  },
  {
    ...text.intentItems.system,
    href: categoryPath('academy', locale),
  },
];
const quickLinks = text.useCases.map((item, index) => ({
  ...item,
  href: [
    radarGalleryPath(locale),
    startHref,
    categoryPath('engineering', locale),
    categoryPath('foundations', locale),
  ][index],
}));
const visibleTags = (tags: string[]) => tags.filter((tag) => publicTagSlugs.has(slugifyTag(tag)));
const compactTags = (tags: string[]) => {
  const visible = visibleTags(tags);
  return {
    primary: visible[0],
    remaining: Math.max(0, visible.length - 1),
  };
};
const radarImageWidth = 2752;
const radarImageHeight = 1536;
---

<TransparentAquarium locale={locale} />

<section class="home-hero relative left-1/2 w-screen -translate-x-1/2 overflow-hidden">
  <div class="absolute inset-0 grid grid-cols-1 opacity-80 md:grid-cols-3" aria-hidden="true">
    {recentVisualStories.slice(0, 3).map((item) => (
      <Image
        src={resolveSiteUrl(item.entry.data.coverImage ?? '')}
        alt=""
        width={radarImageWidth}
        height={radarImageHeight}
        loading="eager"
        decoding="async"
        class="h-full min-h-[34rem] w-full object-cover"
      />
    ))}
  </div>
  <div class="home-hero-scrim absolute inset-0" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto flex min-h-[22rem] max-w-6xl flex-col justify-end px-6 py-10 md:min-h-[38rem] md:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.34em] text-cyan-100/85">{text.eyebrow}</p>
    <h1 class="mt-4 max-w-[11ch] text-balance text-4xl font-semibold leading-[0.98] text-white md:mt-5 md:text-6xl xl:text-7xl">
      <span class="md:hidden">{text.mobileTitle}</span>
      <span class="hidden md:inline">{text.title}</span>
    </h1>
    <p class="mt-4 max-w-3xl text-base leading-7 text-slate-100 md:mt-6 md:text-xl md:leading-8">
      <span class="md:hidden">{text.mobileDescription}</span>
      <span class="hidden md:inline">{text.description}</span>
    </p>

    <div class="mt-6 flex flex-wrap gap-3 md:mt-8">
      <a href={startHref} class="home-hero-action rounded-2xl px-5 py-3 text-sm font-semibold">
        {text.heroCta}
      </a>
      <a href={radarPath} class="home-hero-action-secondary rounded-2xl px-5 py-3 text-sm font-semibold">
        {text.heroSecondaryCta}
      </a>
    </div>

    <dl class="home-hero-metrics mt-6 text-white md:mt-8">
      <div class="home-hero-metric">
        <dt class="sr-only">{text.contentUnit}</dt>
        <dd>
          <span class="home-hero-metric-value">{entries.length}</span>
          <span class="home-hero-metric-label">{text.contentUnit}</span>
        </dd>
      </div>
      <div class="home-hero-metric">
        <dt class="sr-only">{text.visualUnit}</dt>
        <dd>
          <span class="home-hero-metric-value">{visualCount}</span>
          <span class="home-hero-metric-label">{text.visualUnit}</span>
        </dd>
      </div>
      <div class="home-hero-metric">
        <dt class="sr-only">{text.tagUnit}</dt>
        <dd>
          <span class="home-hero-metric-value">{tagIndex.length}</span>
          <span class="home-hero-metric-label">{text.tagUnit}</span>
        </dd>
      </div>
    </dl>
  </div>
</section>

<section class="mt-10">
  <div class="max-w-3xl">
    <p class="theme-kicker text-xs font-semibold uppercase tracking-[0.3em]">Start Here</p>
    <h2 class="theme-heading mt-3 text-3xl font-semibold leading-tight md:text-4xl">{text.intentTitle}</h2>
    <p class="theme-muted mt-4 text-base leading-7">{text.intentDescription}</p>
  </div>
  <div class="mt-6 grid gap-4 lg:grid-cols-3">
    {intentItems.map((item) => (
      <a href={item.href} class="theme-panel theme-panel-link flex min-h-[14rem] flex-col rounded-[1.25rem] p-5">
        <p class="theme-muted text-xs uppercase tracking-[0.24em]">{item.label}</p>
        <h3 class="theme-heading mt-4 text-2xl font-semibold leading-tight">{item.title}</h3>
        <p class="theme-muted mt-4 text-sm leading-6">{item.description}</p>
        <span class="theme-button-soft mt-auto inline-flex w-fit rounded-[1rem] px-3.5 py-2 text-sm font-medium">
          {item.cta}
        </span>
      </a>
    ))}
  </div>
</section>

<section class="mt-12">
  <div class="max-w-3xl">
    <p class="theme-kicker text-xs font-semibold uppercase tracking-[0.3em]">Content Map</p>
    <h2 class="theme-heading mt-3 text-3xl font-semibold leading-tight md:text-4xl">{text.routesTitle}</h2>
    <p class="theme-muted mt-4 text-base leading-7">{text.routesDescription}</p>
  </div>
  <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {routeItems.map((item) => (
      <a href={item.href} class="theme-panel theme-panel-link flex min-h-[15rem] flex-col rounded-[1.25rem] p-5">
        <div class="flex items-start justify-between gap-3">
          <p class="theme-muted text-xs uppercase tracking-[0.24em]">{collectionLabels[item.category][locale]}</p>
          <span class="theme-chip rounded-xl px-3 py-1 text-xs">{item.count}</span>
        </div>
        <h3 class="theme-heading mt-5 text-2xl font-semibold leading-tight">{item.title}</h3>
        <p class="theme-muted mt-4 text-sm leading-6">{item.description}</p>
        <span class="theme-button-soft mt-auto inline-flex w-fit rounded-[1rem] px-3.5 py-2 text-sm font-medium">
          {text.routeCta}
        </span>
      </a>
    ))}
  </div>
</section>

{recentVisualStories.length > 0 ? (
  <section class="mt-12 grid gap-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.35fr)] lg:items-start">
    <div class="py-2">
      <p class="theme-kicker text-xs font-semibold uppercase tracking-[0.3em]">Visual Radar</p>
      <h2 class="theme-heading mt-3 text-3xl font-semibold leading-tight md:text-4xl">{text.visualTitle}</h2>
      <p class="theme-muted mt-4 text-base leading-7">{text.visualDescription}</p>
      <a
        href={radarGalleryPath(locale)}
        class="theme-action-primary mt-6 inline-flex rounded-[1rem] px-4 py-3 text-sm font-semibold"
      >
        {text.recentVisualsCta}
      </a>
    </div>
    <div class="grid gap-4 md:grid-cols-3 lg:grid-cols-3">
      {recentVisualStories.map((item) => (
        <a href={articlePath(item.entry.data.category, item.slug, locale)} class="theme-panel theme-panel-link overflow-hidden rounded-[1rem]">
          <Image
            src={resolveSiteUrl(item.entry.data.coverImage ?? '')}
            alt={item.entry.data.title}
            width={radarImageWidth}
            height={radarImageHeight}
            loading="lazy"
            decoding="async"
            class="aspect-[16/10] w-full object-cover"
          />
          <div class="p-4">
            <p class="theme-muted text-[11px] uppercase tracking-[0.2em]">{formatDate(item.entry.data.date, locale)}</p>
            <p class="theme-heading mt-2 line-clamp-2 text-sm font-semibold leading-snug">{item.entry.data.title}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
) : null}

{recommendedStory ? (
  <section class="mt-12 grid gap-5 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1.25fr)] lg:items-stretch">
    <a
      href={articlePath(recommendedStory.entry.data.category, recommendedStory.slug, locale)}
      class="theme-panel theme-panel-link flex min-h-[17rem] flex-col rounded-[1.5rem] p-6 shadow-glow"
      data-home-recommendation
    >
      <p class="theme-kicker text-xs font-semibold uppercase tracking-[0.3em]">{text.recommendEyebrow}</p>
      <h2 class="theme-heading mt-3 text-3xl font-semibold leading-tight md:text-4xl">{text.recommendTitle}</h2>
      <p class="theme-muted mt-4 text-sm leading-6">{text.recommendDescription}</p>
      <div class="mt-auto pt-6">
        <p class="theme-muted text-xs uppercase tracking-[0.2em]">
          {collectionLabels[recommendedStory.entry.data.category][locale]} · {formatDate(recommendedStory.entry.data.date, locale)}
        </p>
        <p class="theme-heading mt-2 text-xl font-semibold leading-snug">{recommendedStory.entry.data.title}</p>
        <span class="theme-button-soft mt-5 inline-flex w-fit rounded-[1rem] px-3.5 py-2 text-sm font-medium">
          {text.recommendCta}
        </span>
      </div>
    </a>

    <section class="theme-panel rounded-[1.5rem] p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="theme-kicker text-xs font-semibold uppercase tracking-[0.3em]">Quick Links</p>
          <h2 class="theme-heading mt-3 text-2xl font-semibold leading-tight">{text.quickLinksTitle}</h2>
        </div>
        <a href={rssHref} class="theme-chip theme-chip-link rounded-xl px-3 py-1 text-sm font-semibold">
          RSS
        </a>
      </div>
      <div class="mt-5 grid gap-3 md:grid-cols-2">
        {quickLinks.map((item) => (
          <a href={item.href} class="theme-button-soft rounded-[1rem] px-4 py-3" data-home-quick-link>
            <span class="theme-heading block text-base font-semibold">{item.label}</span>
            <span class="theme-muted mt-2 block text-sm leading-6">{item.description}</span>
          </a>
        ))}
      </div>
    </section>
  </section>
) : null}

<section class="mt-12 grid gap-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(280px,0.72fr)]">
  <section id="latest" class="theme-panel rounded-[1.5rem] p-5 scroll-mt-44 md:p-6">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="theme-muted text-xs uppercase tracking-[0.28em]">{text.updates}</p>
        <h2 class="theme-heading mt-2 text-2xl font-semibold">{text.latest}</h2>
      </div>
      <span class="theme-chip rounded-xl px-3 py-1 text-xs">{recentStories.length}</span>
    </div>
    <div class="mt-5 grid gap-3 md:grid-cols-2">
      {recentStories.map((item) => (
        <a
          href={articlePath(item.entry.data.category, item.slug, locale)}
          class="theme-button-soft flex min-h-[8.5rem] flex-col rounded-[1rem] px-4 py-3"
        >
          <div class="flex items-center justify-between gap-3 text-[11px] uppercase tracking-[0.2em] theme-muted">
            <span>{collectionLabels[item.entry.data.category][locale]}</span>
            <span>{formatDate(item.entry.data.date, locale)}</span>
          </div>
          <p class="theme-heading mt-3 line-clamp-2 text-lg font-semibold leading-snug">{item.entry.data.title}</p>
          <div class="mt-auto flex flex-wrap gap-2 pt-4">
            {compactTags(item.entry.data.tags).primary ? (
              <span class="theme-chip rounded-xl px-2.5 py-1 text-xs" data-card-primary-tag>
                {compactTags(item.entry.data.tags).primary}
              </span>
            ) : null}
            {compactTags(item.entry.data.tags).remaining > 0 ? (
              <span class="theme-chip rounded-xl px-2.5 py-1 text-xs" data-card-tag-overflow>
                +{compactTags(item.entry.data.tags).remaining}
              </span>
            ) : null}
          </div>
        </a>
      ))}
    </div>
  </section>

  <aside class="grid content-start gap-4 lg:sticky lg:top-28">
    {topicIndex.length > 0 ? (
      <section class="theme-panel rounded-[1.5rem] p-6">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="theme-muted text-xs uppercase tracking-[0.28em]">{topicsText.eyebrow}</p>
            <h2 class="theme-heading mt-2 text-2xl font-semibold">{topicsText.title}</h2>
          </div>
          <span class="theme-chip rounded-xl px-3 py-1 text-xs">{topicIndex.length}</span>
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          {topicIndex.map(({ topic, count }) => (
            <a
              href={topicPath(topic, locale)}
              class="theme-chip theme-chip-link rounded-xl px-3 py-1 text-sm font-semibold"
            >
              {topicCopyByLocale[topic].label}
              <span class="ml-1 text-xs opacity-70">{count}</span>
            </a>
          ))}
        </div>
        <a
          href={topicIndexPath(locale)}
          class="theme-button-soft mt-5 inline-flex w-full items-center justify-center rounded-[1rem] px-4 py-3 text-sm font-medium"
        >
          {topicsText.title}
        </a>
      </section>
    ) : null}

    <section class="theme-panel rounded-[1.5rem] p-6">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="theme-muted text-xs uppercase tracking-[0.28em]">{text.tags}</p>
          <h2 class="theme-heading mt-2 text-2xl font-semibold">{text.tags}</h2>
        </div>
        <span class="theme-chip rounded-xl px-3 py-1 text-xs">{tagIndex.length}</span>
      </div>
      <p class="theme-muted mt-3 text-sm leading-6">{text.sideNote}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {tagIndex.slice(0, 14).map((tag) => (
          <a href={tagPath(tag.label, locale)} class="theme-chip theme-chip-link rounded-xl px-3 py-1 text-sm">
            {tag.label}
          </a>
        ))}
      </div>
      <a
        href={tagIndexPath(locale)}
        class="theme-button-soft mt-5 inline-flex w-full items-center justify-center rounded-[1rem] px-4 py-3 text-sm font-medium"
      >
        {text.tagIndexCta}
      </a>
    </section>
  </aside>
</section>

<style>
  .home-hero {
    margin-top: -2.5rem;
    background: #08111f;
  }

  .home-hero-scrim {
    background:
      linear-gradient(90deg, rgba(5, 12, 24, 0.96) 0%, rgba(5, 12, 24, 0.78) 38%, rgba(5, 12, 24, 0.28) 100%),
      linear-gradient(0deg, rgba(5, 12, 24, 0.78) 0%, rgba(5, 12, 24, 0.12) 46%, rgba(5, 12, 24, 0.72) 100%);
  }

  .home-hero-action {
    color: #07111f;
    background: #f8fafc;
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.22);
  }

  .home-hero-action-secondary {
    color: #f8fafc;
    background: rgba(15, 23, 42, 0.58);
    border: 1px solid rgba(226, 232, 240, 0.32);
    backdrop-filter: blur(12px);
  }

  .home-hero-metrics {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    padding: 0;
  }

  .home-hero-metric {
    display: inline-flex;
    align-items: baseline;
  }

  .home-hero-metric:not(:last-child)::after {
    content: '';
    width: 0.28rem;
    height: 0.28rem;
    margin-left: 1rem;
    border-radius: 999px;
    background: rgba(226, 232, 240, 0.38);
  }

  .home-hero-metric dd {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    margin: 0;
  }

  .home-hero-metric-value {
    font-size: 1.25rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0;
  }

  .home-hero-metric-label {
    white-space: nowrap;
    color: rgba(226, 232, 240, 0.78);
    font-size: 0.95rem;
    line-height: 1;
  }

  @media (max-width: 767px) {
    .home-hero-scrim {
      background:
        linear-gradient(0deg, rgba(5, 12, 24, 0.92) 0%, rgba(5, 12, 24, 0.62) 48%, rgba(5, 12, 24, 0.82) 100%);
    }
  }
</style>
