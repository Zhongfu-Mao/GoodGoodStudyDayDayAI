---
import {
  articlePath,
  categoryPath,
  collectionLabels,
  collectionNames,
  radarGalleryPath,
  resolveSiteUrl,
  tagIndexPath,
  tagPath,
  type Locale,
} from '../lib/site';
import { getEntriesForLocale, getTagIndex } from '../lib/content';
import { formatDate, homePage } from '../lib/i18n';

function cleanMarkdownText(text: string) {
  return text
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[`*_>#]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}

function getRepresentativeLead(body: string) {
  const match = body.match(/\*([^*]+)\*/);

  if (!match) return '';

  const cleaned = cleanMarkdownText(match[1]);
  const firstSentenceBreak = cleaned.indexOf('。');
  const withoutSource =
    firstSentenceBreak >= 0 && (cleaned.startsWith('代表图来自') || cleaned.startsWith('代表画像は'))
      ? cleaned.slice(firstSentenceBreak + 1).trim()
      : cleaned;

  return withoutSource;
}

function getNarrativeParagraphs(body: string) {
  return body
    .split(/\n\s*\n/)
    .map((block) => block.trim())
    .filter(Boolean)
    .filter((block) => !block.startsWith('#'))
    .filter((block) => !block.startsWith('!['))
    .filter((block) => !block.startsWith('---'))
    .filter((block) => !block.startsWith('*'))
    .filter((block) => !/^([-*]\s)/.test(block))
    .filter((block) => !block.startsWith('**来源：**'))
    .filter((block) => !block.startsWith('**出典：**'))
    .map(cleanMarkdownText)
    .filter((block) => block.length >= 40);
}

function isGenericLead(text: string, locale: Locale) {
  if (!text) return true;

  return locale === 'ja'
    ? /^(この日の|この週|この数日|4 月|この回は)|原始シグナル/.test(text)
    : /^(它对应|这张图|它能代表|它更贴合|用它来做|这期同时在看)|原始信号/.test(text);
}

function trimExcerpt(text: string, maxLength = 180) {
  if (text.length <= maxLength) return text.trim();

  const sliced = text.slice(0, maxLength);
  const sentenceBoundary = Math.max(sliced.lastIndexOf('。'), sliced.lastIndexOf('！'), sliced.lastIndexOf('？'));

  if (sentenceBoundary >= Math.floor(maxLength * 0.5)) {
    return sliced.slice(0, sentenceBoundary + 1).trim();
  }

  const phraseBoundary = Math.max(sliced.lastIndexOf('；'), sliced.lastIndexOf('，'));

  if (phraseBoundary >= Math.floor(maxLength * 0.6)) {
    return sliced.slice(0, phraseBoundary + 1).trim();
  }

  return sliced.trim();
}

function getEntryExcerpt(description: string | undefined, body: string | undefined, locale: Locale) {
  if (description) return description;
  if (!body) return '';

  const representativeLead = getRepresentativeLead(body);
  const paragraphs = getNarrativeParagraphs(body);
  const firstNarrative = paragraphs[0] ?? '';

  if (representativeLead && firstNarrative) {
    if (isGenericLead(representativeLead, locale)) {
      return trimExcerpt(firstNarrative);
    }

    const bridge = locale === 'ja' ? ' この回で特に目立ったのは、' : ' 本期还重点关注：';
    return trimExcerpt(`${representativeLead}${bridge}${firstNarrative}`);
  }

  if (representativeLead && !isGenericLead(representativeLead, locale)) {
    return trimExcerpt(representativeLead);
  }

  return trimExcerpt(firstNarrative);
}

const { locale } = Astro.props as { locale: Locale };
const entries = await getEntriesForLocale(locale);
const [featuredStory, ...restStories] = entries;
const spotlightStories = restStories.slice(0, 3);
const recentStories = entries.slice(0, 4);
const recentVisualStories = entries
  .filter((item) => item.entry.data.category === 'radar' && item.entry.data.coverImage)
  .slice(0, 3);
const tagIndex = await getTagIndex(locale);
const text = homePage[locale];
const featuredExcerpt = featuredStory
  ? getEntryExcerpt(featuredStory.entry.data.description, featuredStory.entry.body, locale)
  : '';
const featuredCta = locale === 'ja' ? '記事を読む' : '阅读全文';
const visualCount = entries.filter((item) => item.entry.data.category === 'radar' && item.entry.data.coverImage).length;
const routeItems = collectionNames.map((category) => ({
  category,
  href: categoryPath(category, locale),
  title: text.routes[category].title,
  description: text.routes[category].description,
  count: entries.filter((item) => item.entry.data.category === category).length,
}));
const radarPath = categoryPath('radar', locale);
---

<section class="home-hero relative left-1/2 w-screen -translate-x-1/2 overflow-hidden">
  <div class="absolute inset-0 grid grid-cols-1 opacity-80 md:grid-cols-3" aria-hidden="true">
    {recentVisualStories.slice(0, 3).map((item) => (
      <img
        src={resolveSiteUrl(item.entry.data.coverImage ?? '')}
        alt=""
        loading="eager"
        decoding="async"
        class="h-full min-h-[34rem] w-full object-cover"
      />
    ))}
  </div>
  <div class="home-hero-scrim absolute inset-0" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto flex min-h-[34rem] max-w-6xl flex-col justify-end px-6 py-14 md:min-h-[38rem] md:py-20">
    <p class="text-xs font-semibold uppercase tracking-[0.34em] text-cyan-100/85">{text.eyebrow}</p>
    <h1 class="mt-5 max-w-[11ch] text-balance text-5xl font-semibold leading-[0.95] text-white md:text-6xl xl:text-7xl">
      {text.title}
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-100 md:text-xl">{text.description}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={radarPath} class="home-hero-action rounded-2xl px-5 py-3 text-sm font-semibold">
        {text.heroCta}
      </a>
      <a href={radarGalleryPath(locale)} class="home-hero-action-secondary rounded-2xl px-5 py-3 text-sm font-semibold">
        {text.heroSecondaryCta}
      </a>
    </div>

    <dl class="mt-10 grid max-w-3xl grid-cols-3 gap-3 text-white">
      <div class="home-hero-stat">
        <dt class="text-xs uppercase tracking-[0.2em] text-slate-200/80">{text.contentUnit}</dt>
        <dd class="mt-1 text-3xl font-semibold">{entries.length}</dd>
      </div>
      <div class="home-hero-stat">
        <dt class="text-xs uppercase tracking-[0.2em] text-slate-200/80">{text.visualUnit}</dt>
        <dd class="mt-1 text-3xl font-semibold">{visualCount}</dd>
      </div>
      <div class="home-hero-stat">
        <dt class="text-xs uppercase tracking-[0.2em] text-slate-200/80">{text.tagUnit}</dt>
        <dd class="mt-1 text-3xl font-semibold">{tagIndex.length}</dd>
      </div>
    </dl>
  </div>
</section>

<section class="mt-10">
  <div class="max-w-3xl">
    <p class="theme-kicker text-xs font-semibold uppercase tracking-[0.3em]">Start Here</p>
    <h2 class="theme-heading mt-3 text-3xl font-semibold leading-tight md:text-4xl">{text.routesTitle}</h2>
    <p class="theme-muted mt-4 text-base leading-7">{text.routesDescription}</p>
  </div>
  <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {routeItems.map((item) => (
      <a href={item.href} class="theme-panel theme-panel-link flex min-h-[15rem] flex-col rounded-[1.25rem] p-5">
        <div class="flex items-start justify-between gap-3">
          <p class="theme-muted text-xs uppercase tracking-[0.24em]">{collectionLabels[item.category][locale]}</p>
          <span class="theme-chip rounded-xl px-3 py-1 text-xs">{item.count}</span>
        </div>
        <h3 class="theme-heading mt-5 text-2xl font-semibold leading-tight">{item.title}</h3>
        <p class="theme-muted mt-4 text-sm leading-6">{item.description}</p>
        <span class="theme-button-soft mt-auto inline-flex w-fit rounded-[1rem] px-3.5 py-2 text-sm font-medium">
          {text.routeCta}
        </span>
      </a>
    ))}
  </div>
</section>

{recentVisualStories.length > 0 ? (
  <section class="mt-12 grid gap-6 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.35fr)] lg:items-start">
    <div class="py-2">
      <p class="theme-kicker text-xs font-semibold uppercase tracking-[0.3em]">Visual Radar</p>
      <h2 class="theme-heading mt-3 text-3xl font-semibold leading-tight md:text-4xl">{text.visualTitle}</h2>
      <p class="theme-muted mt-4 text-base leading-7">{text.visualDescription}</p>
      <a
        href={radarGalleryPath(locale)}
        class="theme-action-primary mt-6 inline-flex rounded-[1rem] px-4 py-3 text-sm font-semibold"
      >
        {text.recentVisualsCta}
      </a>
    </div>
    <div class="grid gap-4 md:grid-cols-3 lg:grid-cols-3">
      {recentVisualStories.map((item) => (
        <a href={articlePath(item.entry.data.category, item.slug, locale)} class="theme-panel theme-panel-link overflow-hidden rounded-[1rem]">
          <img
            src={resolveSiteUrl(item.entry.data.coverImage ?? '')}
            alt={item.entry.data.title}
            loading="lazy"
            decoding="async"
            class="aspect-[16/10] w-full object-cover"
          />
          <div class="p-4">
            <p class="theme-muted text-[11px] uppercase tracking-[0.2em]">{formatDate(item.entry.data.date, locale)}</p>
            <p class="theme-heading mt-2 line-clamp-2 text-sm font-semibold leading-snug">{item.entry.data.title}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
) : null}

<section class="mt-12">
  <div class="max-w-3xl">
    <p class="theme-kicker text-xs font-semibold uppercase tracking-[0.3em]">Use Cases</p>
    <h2 class="theme-heading mt-3 text-3xl font-semibold leading-tight md:text-4xl">{text.useTitle}</h2>
    <p class="theme-muted mt-4 text-base leading-7">{text.useDescription}</p>
  </div>
  <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {text.useCases.map((item) => (
      <article class="theme-panel rounded-[1.25rem] p-5">
        <p class="theme-heading text-xl font-semibold">{item.label}</p>
        <p class="theme-muted mt-3 text-sm leading-6">{item.description}</p>
      </article>
    ))}
  </div>
</section>

<section class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,1.55fr)_320px]">
  <div class="grid gap-6">
    {featuredStory ? (
      <section class="grid gap-4 lg:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)]">
        <article class="theme-panel-strong rounded-[1.5rem] p-7 shadow-glow">
          <div class="flex h-full flex-col">
            <p class="theme-kicker text-xs uppercase tracking-[0.28em]">{text.featured}</p>
            <div class="mt-5 flex items-center gap-3 text-xs uppercase tracking-[0.22em] theme-muted">
              <span>{collectionLabels[featuredStory.entry.data.category][locale]}</span>
              <span>{formatDate(featuredStory.entry.data.date, locale)}</span>
            </div>
            <h2 class="theme-heading mt-4 text-3xl font-semibold leading-tight md:text-4xl">
              <a href={articlePath(featuredStory.entry.data.category, featuredStory.slug, locale)}>
                {featuredStory.entry.data.title}
              </a>
            </h2>
            {featuredExcerpt ? (
              <p class="theme-muted mt-5 text-base leading-7">
                {featuredExcerpt}
              </p>
            ) : null}
            <div class="mt-6 flex flex-wrap gap-2">
              {featuredStory.entry.data.tags.map((tag) => (
                <a href={tagPath(tag, locale)} class="theme-chip theme-chip-link rounded-xl px-3 py-1 text-sm">
                  {tag}
                </a>
              ))}
            </div>
            <div class="mt-auto pt-6">
              <a
                href={articlePath(featuredStory.entry.data.category, featuredStory.slug, locale)}
                class="theme-button-soft inline-flex items-center rounded-[1rem] px-4 py-3 text-sm font-medium"
              >
                {featuredCta}
              </a>
            </div>
          </div>
        </article>

        <div class="grid gap-4">
          {spotlightStories.map((item) => (
            <article class="theme-panel theme-panel-link rounded-[1.25rem] p-5">
              <div class="flex items-center justify-between gap-3 text-[11px] uppercase tracking-[0.24em] theme-muted">
                <span>{collectionLabels[item.entry.data.category][locale]}</span>
                <span>{formatDate(item.entry.data.date, locale)}</span>
              </div>
              <h3 class="theme-heading mt-3 text-xl font-semibold leading-snug">
                <a href={articlePath(item.entry.data.category, item.slug, locale)}>{item.entry.data.title}</a>
              </h3>
              <div class="mt-4 flex flex-wrap gap-2">
                {item.entry.data.tags.slice(0, 3).map((tag) => (
                  <a href={tagPath(tag, locale)} class="theme-chip theme-chip-link rounded-xl px-3 py-1 text-xs">
                    {tag}
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>
    ) : null}
  </div>

  <aside class="grid content-start gap-4 lg:sticky lg:top-28">
    <section class="theme-panel rounded-[1.5rem] p-6">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="theme-muted text-xs uppercase tracking-[0.28em]">{text.tags}</p>
          <h2 class="theme-heading mt-2 text-2xl font-semibold">{text.tags}</h2>
        </div>
        <span class="theme-chip rounded-xl px-3 py-1 text-xs">{tagIndex.length}</span>
      </div>
      <p class="theme-muted mt-3 text-sm leading-6">{text.sideNote}</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {tagIndex.slice(0, 14).map((tag) => (
          <a href={tagPath(tag.label, locale)} class="theme-chip theme-chip-link rounded-xl px-3 py-1 text-sm">
            {tag.label}
          </a>
        ))}
      </div>
      <a
        href={tagIndexPath(locale)}
        class="theme-button-soft mt-5 inline-flex w-full items-center justify-center rounded-[1rem] px-4 py-3 text-sm font-medium"
      >
        {text.tagIndexCta}
      </a>
    </section>

    <section id="latest" class="theme-panel rounded-[1.5rem] p-6 scroll-mt-44">
      <p class="theme-muted text-xs uppercase tracking-[0.28em]">{text.latest}</p>
      <div class="mt-4 grid gap-3">
        {recentStories.map((item) => (
          <a href={articlePath(item.entry.data.category, item.slug, locale)} class="theme-button-soft rounded-[1rem] px-4 py-3">
            <p class="theme-muted text-[11px] uppercase tracking-[0.2em]">{collectionLabels[item.entry.data.category][locale]}</p>
            <p class="theme-heading mt-2 text-base font-semibold leading-snug">{item.entry.data.title}</p>
            <p class="theme-muted mt-2 text-sm">
              {formatDate(item.entry.data.date, locale)}
            </p>
          </a>
        ))}
      </div>
    </section>
  </aside>
</section>

<style>
  .home-hero {
    margin-top: -2.5rem;
    background: #08111f;
  }

  .home-hero-scrim {
    background:
      linear-gradient(90deg, rgba(5, 12, 24, 0.96) 0%, rgba(5, 12, 24, 0.78) 38%, rgba(5, 12, 24, 0.28) 100%),
      linear-gradient(0deg, rgba(5, 12, 24, 0.78) 0%, rgba(5, 12, 24, 0.12) 46%, rgba(5, 12, 24, 0.72) 100%);
  }

  .home-hero-action {
    color: #07111f;
    background: #f8fafc;
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.22);
  }

  .home-hero-action-secondary {
    color: #f8fafc;
    background: rgba(15, 23, 42, 0.58);
    border: 1px solid rgba(226, 232, 240, 0.32);
    backdrop-filter: blur(12px);
  }

  .home-hero-stat {
    padding: 0.9rem 1rem;
    background: rgba(15, 23, 42, 0.54);
    border: 1px solid rgba(226, 232, 240, 0.2);
    border-radius: 1rem;
    backdrop-filter: blur(14px);
  }

  @media (max-width: 767px) {
    .home-hero-scrim {
      background:
        linear-gradient(0deg, rgba(5, 12, 24, 0.92) 0%, rgba(5, 12, 24, 0.62) 48%, rgba(5, 12, 24, 0.82) 100%);
    }
  }
</style>
