---
import type { CollectionEntry } from 'astro:content';
import {
  articlePath,
  cadenceLabels,
  collectionLabels,
  resolveSiteUrl,
  type CollectionName,
  type Locale,
} from '../lib/site';
import { formatDate } from '../lib/i18n';
import { resolveRadarCadence } from '../lib/radar';

const {
  item,
  locale,
  loading = 'lazy',
  preview = false,
} = Astro.props as {
  item: {
    collection: CollectionName;
    slug: string;
    entry: CollectionEntry<CollectionName>;
  };
  locale: Locale;
  loading?: 'eager' | 'lazy';
  preview?: boolean;
};

const href = articlePath(item.entry.data.category, item.slug, locale);
const coverImage = item.entry.data.coverImage ? resolveSiteUrl(item.entry.data.coverImage) : undefined;
const cadence = resolveRadarCadence(item);
const cadenceLabel = cadence ? cadenceLabels[cadence][locale] : collectionLabels.radar[locale];
const dateLabel = formatDate(item.entry.data.date, locale);
const month = item.entry.data.date.toISOString().slice(0, 7);
const previewAlt = locale === 'ja'
  ? `${item.entry.data.title} のインフォグラフィック`
  : `${item.entry.data.title} 的信息图`;
const previewTooltip = locale === 'ja'
  ? `${item.entry.data.title} をプレビュー`
  : `预览大图：${item.entry.data.title}`;
const tags = item.entry.data.tags.slice(0, 3);
const fallbackTitle = cadence === 'daily'
  ? (locale === 'ja' ? 'AI Radar Daily' : 'AI 雷达日报')
  : item.entry.data.title;
const displayTitle = cadence === 'daily'
  ? item.entry.data.title
      .replace(/^AI 雷达日报[:：]\s*\d{4}-\d{2}-\d{2}\s*[-—–]*\s*/, '')
      .replace(/^AI Radar Daily:\s*\d{4}-\d{2}-\d{2}\s*[-—–]*\s*/, '')
      .trim() || fallbackTitle
  : item.entry.data.title;
const placeholderKicker = locale === 'ja' ? 'テキスト稿' : '文字稿';
---

<article
  class="radar-visual-card theme-panel group flex h-full flex-col overflow-hidden rounded-[1rem] shadow-glow transition duration-200 hover:-translate-y-1"
  data-gallery-card
  data-cadence={cadence ?? 'radar'}
  data-month={month}
>
  {coverImage ? (
    preview ? (
      <button
        type="button"
        class="radar-visual-media ui-tooltip ui-tooltip-inset-top relative block w-full overflow-hidden bg-[#f5efe4] text-left"
        data-preview-trigger
        data-image-src={coverImage}
        data-image-alt={previewAlt}
        data-title={item.entry.data.title}
        data-meta={`${cadenceLabel} · ${dateLabel}`}
        data-href={href}
        data-tooltip={previewTooltip}
        aria-label={locale === 'ja' ? '画像をプレビュー' : '预览大图'}
      >
        <img
          src={coverImage}
          alt={previewAlt}
          loading={loading}
          decoding="async"
          class="block h-full w-full object-contain transition duration-200 group-hover:scale-[1.012]"
        />
      </button>
    ) : (
      <a href={href} class="radar-visual-media relative block w-full overflow-hidden bg-[#f5efe4] text-left">
        <img
          src={coverImage}
          alt={previewAlt}
          loading={loading}
          decoding="async"
          class="block h-full w-full object-contain transition duration-200 group-hover:scale-[1.012]"
        />
      </a>
    )
  ) : (
    <a href={href} class="radar-visual-placeholder relative flex min-h-[11rem] w-full overflow-hidden p-4 sm:min-h-[12.5rem] sm:p-5">
      <div class="radar-placeholder-map pointer-events-none absolute inset-x-5 top-12 grid grid-cols-3 gap-2 sm:inset-x-8 sm:top-14" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="relative z-10 flex min-w-0 flex-1 flex-col justify-between gap-7">
        <div class="flex items-center justify-between gap-3 text-xs uppercase tracking-[0.16em] theme-muted">
          <span>{cadenceLabel}</span>
          <time datetime={item.entry.data.date.toISOString()}>{dateLabel}</time>
        </div>
        <div class="min-w-0 max-w-3xl">
          <p class="theme-kicker text-[11px] uppercase tracking-[0.2em]">{placeholderKicker}</p>
          <p class="theme-heading mt-2 max-w-full break-words text-xl font-semibold leading-snug sm:text-2xl">
            {displayTitle}
          </p>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <span class="radar-visual-tag rounded-md px-2.5 py-1 text-xs font-medium leading-4">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </div>
    </a>
  )}

  <div class="px-3 py-2.5">
    <div class="radar-card-bar flex min-h-[2.75rem] flex-col justify-center gap-1.5">
      <div class="radar-card-meta flex shrink-0 flex-wrap items-center gap-x-2 gap-y-0.5 text-xs uppercase tracking-[0.12em] theme-muted">
        <span>{cadenceLabel}</span>
        <span aria-hidden="true" class="opacity-50">/</span>
        <time datetime={item.entry.data.date.toISOString()}>{dateLabel}</time>
      </div>
      <div class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3 gap-y-1.5">
        <h2 class="radar-card-title theme-heading min-w-0 max-w-full flex-1 text-[18px] font-semibold leading-6">{displayTitle}</h2>
        <div class="radar-card-tags flex shrink-0 flex-wrap justify-start gap-1.5">
          {tags.map((tag) => (
            <span class="radar-visual-tag rounded-md px-2.5 py-1 text-xs font-medium leading-4">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .radar-visual-card {
    container-type: inline-size;
  }

  .radar-visual-media {
    aspect-ratio: 16 / 10;
  }

  .radar-card-meta {
    width: auto;
  }

  .radar-card-tags {
    margin-left: 0;
  }

  @container (min-width: 38rem) {
    .radar-card-bar {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 0.75rem;
    }

    .radar-card-meta {
      width: 9.75rem;
    }

    .radar-card-title {
      min-width: 12rem;
    }

    .radar-card-tags {
      justify-content: flex-end;
      margin-left: auto;
    }
  }

  .radar-visual-tag {
    background: color-mix(in srgb, var(--theme-accent) 14%, var(--theme-surface-strong));
    border: 1px solid color-mix(in srgb, var(--theme-accent) 38%, var(--theme-border));
    color: color-mix(in srgb, var(--theme-accent) 78%, var(--theme-page-text));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .radar-visual-placeholder {
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--theme-accent) 14%, transparent),
        color-mix(in srgb, var(--theme-surface-strong) 92%, transparent)
      ),
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--theme-border) 26%, transparent) 0 1px,
        transparent 1px 32px
      ),
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--theme-border) 22%, transparent) 0 1px,
        transparent 1px 32px
      ),
      var(--theme-surface-strong);
  }

  .radar-visual-placeholder::before {
    position: absolute;
    inset: 0.9rem;
    content: '';
    border: 1px solid color-mix(in srgb, var(--theme-accent) 18%, var(--theme-border));
    border-radius: 0.85rem;
  }

  .radar-visual-placeholder::after {
    position: absolute;
    right: 1.1rem;
    bottom: 0.9rem;
    width: min(14rem, 42%);
    height: 0.28rem;
    content: '';
    background: color-mix(in srgb, var(--theme-accent) 34%, transparent);
    border-radius: 999px;
  }

  .radar-placeholder-map span {
    height: clamp(2rem, 6vw, 3.25rem);
    border: 1px solid color-mix(in srgb, var(--theme-accent) 22%, var(--theme-border));
    border-radius: 0.7rem;
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--theme-accent) 20%, transparent) 0 0.35rem,
        transparent 0.35rem
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--theme-page-text) 10%, transparent) 0 0.45rem,
        transparent 0.45rem
      );
    opacity: 0.45;
  }

  .radar-placeholder-map span:nth-child(2) {
    transform: translateY(0.7rem);
  }

  .radar-placeholder-map span:nth-child(3) {
    transform: translateY(0.2rem);
  }

  :global(html[data-theme='light']) .radar-visual-tag {
    background: color-mix(in srgb, var(--theme-accent-soft) 76%, #ffffff);
    border-color: color-mix(in srgb, var(--theme-accent) 28%, rgba(228, 228, 231, 0.96));
    color: #6f481b;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
  }
</style>
