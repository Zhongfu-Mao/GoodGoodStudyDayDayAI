---
import { locales, withBase, withoutBase, type Locale } from '../lib/site';
import { languageSwitcher } from '../lib/i18n';

const currentLocale = (Astro.currentLocale ?? 'zh') as Locale;
const labels = languageSwitcher[currentLocale];
const pathname = withoutBase(Astro.url.pathname);
const paths = (Astro.props.paths ?? {}) as Partial<Record<Locale, string>>;
const tooltips: Record<Locale, Record<Locale, string>> = {
  zh: { zh: '切换到中文', ja: '切换到日本語' },
  ja: { zh: '中文に切り替え', ja: '日本語に切り替え' },
};

function localizedPath(targetLocale: Locale) {
  if (paths[targetLocale]) {
    return paths[targetLocale]!;
  }

  const basePath = pathname === '/ja' ? '/' : pathname.startsWith('/ja/') ? pathname.slice(3) : pathname;

  if (targetLocale === 'ja') {
    return withBase(basePath === '/' ? '/ja/' : `/ja${basePath}`);
  }

  return withBase(basePath);
}
---

<nav aria-label="Language switcher" class="theme-panel inline-flex shrink-0 rounded-2xl p-1 text-sm backdrop-blur">
  {locales.map((locale) => (
    <a
      href={localizedPath(locale)}
      data-tooltip={tooltips[currentLocale][locale]}
      class:list={[
        'ui-tooltip ui-tooltip-bottom inline-flex items-center whitespace-nowrap rounded-xl px-3 py-1 font-medium transition',
        locale === currentLocale
          ? 'theme-segment-active'
          : 'theme-muted theme-button-soft',
      ]}
      aria-current={locale === currentLocale ? 'page' : undefined}
    >
      {labels[locale]}
    </a>
  ))}
</nav>
