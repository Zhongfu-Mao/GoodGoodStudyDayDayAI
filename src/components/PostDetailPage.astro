---
import type { CollectionEntry } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { getEntriesForLocale } from '../lib/content';
import {
  articlePath,
  categoryPath,
  collectionLabels,
  stripLocaleSuffix,
  tagPath,
  type CollectionName,
  type Locale,
  type RadarCadence,
} from '../lib/site';

type BlogCollection = CollectionName;
type BlogEntry = CollectionEntry<BlogCollection>;

const { locale, entry, Content } = Astro.props as {
  locale: Locale;
  entry: BlogEntry;
  Content: AstroComponentFactory;
};
const isGeneratedInfographic =
  typeof entry.data.coverImage === 'string' && entry.data.coverImage.includes('/images/radar/');
const currentSlug = stripLocaleSuffix(entry.id, locale);
const allEntries = await getEntriesForLocale(locale);
const categoryEntries = allEntries.filter((item) => item.entry.data.category === entry.data.category);

function resolveRadarCadence(item: { slug: string; entry: { id: string; data: { cadence?: string } } }) {
  const explicitCadence = item.entry.data.cadence?.toLowerCase();

  if (explicitCadence === 'daily' || explicitCadence === 'weekly' || explicitCadence === 'monthly') {
    return explicitCadence as RadarCadence;
  }

  const fallbackSource = `${item.slug} ${item.entry.id}`.toLowerCase();

  if (fallbackSource.includes('daily')) return 'daily';
  if (fallbackSource.includes('weekly')) return 'weekly';
  if (fallbackSource.includes('monthly')) return 'monthly';

  return undefined;
}

function formatArchiveGroupLabel(date: Date, locale: Locale) {
  return date.toLocaleDateString(locale === 'ja' ? 'ja-JP' : 'zh-CN', {
    year: 'numeric',
    month: 'long',
  });
}

function getMonthKey(date: Date) {
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
}

const currentCadence = entry.data.category === 'radar' ? resolveRadarCadence({ slug: currentSlug, entry }) : undefined;
const sameSeriesEntries =
  entry.data.category === 'radar' && currentCadence
    ? categoryEntries.filter((item) => resolveRadarCadence(item) === currentCadence)
    : categoryEntries;
const currentSeriesIndex = sameSeriesEntries.findIndex((item) => item.entry.id === entry.id);
const newerEntry = currentSeriesIndex > 0 ? sameSeriesEntries[currentSeriesIndex - 1] : undefined;
const olderEntry =
  currentSeriesIndex !== -1 && currentSeriesIndex < sameSeriesEntries.length - 1
    ? sameSeriesEntries[currentSeriesIndex + 1]
    : undefined;
const currentMonthKey = getMonthKey(entry.data.date);
const currentMonthLabel = formatArchiveGroupLabel(entry.data.date, locale);
const sidebarEntries = sameSeriesEntries.filter((item) => getMonthKey(item.entry.data.date) === currentMonthKey);
const archiveHref =
  entry.data.category === 'radar' && currentCadence
    ? `${categoryPath('radar', locale)}#${currentCadence}-${currentMonthKey}`
    : categoryPath(entry.data.category, locale);

const copy = {
  zh: {
    quickJump: '快速导航',
    openCategory: '查看分区',
    openCategoryHint: '返回当前分区',
    openArchive: entry.data.category === 'radar' ? '查看完整归档' : '查看完整列表',
    openArchiveHint:
      entry.data.category === 'radar' ? '分类页包含全部历史内容。' : '分类页包含完整列表。',
    timeline: '继续阅读',
    timelineHint: '查看相邻内容。',
    newerEntry: '较新一篇',
    olderEntry: '较早一篇',
    noNewerEntry: '已经是这一组里最新的一篇。',
    noOlderEntry: '已经到这一组里最早的一篇。',
    sameSeries: currentMonthLabel,
    sameSeriesHint: '当前月份内容。',
    currentArticle: '当前',
  },
  ja: {
    quickJump: 'クイックナビ',
    openCategory: '区分ページへ',
    openCategoryHint: 'この区分の一覧へ戻る',
    openArchive: entry.data.category === 'radar' ? '完全アーカイブを見る' : '一覧を見る',
    openArchiveHint:
      entry.data.category === 'radar'
        ? '分類ページに履歴全体があります。'
        : '分類ページに一覧があります。',
    timeline: '続けて読む',
    timelineHint: '前後の記事を表示します。',
    newerEntry: '新しい側',
    olderEntry: '古い側',
    noNewerEntry: 'このグループでは最も新しい記事です。',
    noOlderEntry: 'このグループでは最も古い記事です。',
    sameSeries: currentMonthLabel,
    sameSeriesHint: '今月分の記事一覧です。',
    currentArticle: '現在地',
  },
} as const;

const text = copy[locale];
---

<section class="grid gap-8 xl:grid-cols-[17rem_minmax(0,1fr)]">
  <aside class="grid content-start gap-4 xl:sticky xl:top-28">
    <section class="theme-panel rounded-[1.5rem] p-5">
      <p class="theme-muted text-xs uppercase tracking-[0.28em]">{text.quickJump}</p>
      <h2 class="theme-heading mt-2 text-2xl font-semibold">{collectionLabels[entry.data.category][locale]}</h2>
      <p class="theme-muted mt-3 text-sm leading-6">{text.openCategoryHint}</p>
      <a
        href={categoryPath(entry.data.category, locale)}
        class="theme-button-soft mt-5 inline-flex w-full items-center justify-between rounded-[1rem] px-4 py-3 text-sm"
      >
        <span>{text.openCategory}</span>
        <span aria-hidden="true">↗</span>
      </a>
      <p class="theme-muted mt-5 text-xs uppercase tracking-[0.24em]">{text.openArchiveHint}</p>
      <a
        href={archiveHref}
        class="theme-button-soft mt-3 inline-flex w-full items-center justify-between rounded-[1rem] px-4 py-3 text-sm"
      >
        <span>{text.openArchive}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section class="theme-panel rounded-[1.5rem] p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="theme-muted text-xs uppercase tracking-[0.28em]">{text.timeline}</p>
          <h2 class="theme-heading mt-2 text-xl font-semibold">{text.timeline}</h2>
        </div>
        <span class="theme-chip rounded-xl px-3 py-1 text-xs">{sameSeriesEntries.length}</span>
      </div>
      <p class="theme-muted mt-3 text-sm leading-6">{text.timelineHint}</p>

      <div class="mt-5 grid gap-3">
        <div class="theme-panel rounded-[1rem] p-4">
          <p class="theme-muted text-xs uppercase tracking-[0.2em]">{text.newerEntry}</p>
          {newerEntry ? (
            <a href={articlePath(newerEntry.entry.data.category, newerEntry.slug, locale)} class="mt-3 block">
              <p class="theme-heading text-sm font-semibold leading-6">{newerEntry.entry.data.title}</p>
              <p class="theme-muted mt-2 text-xs uppercase tracking-[0.2em]">
                {newerEntry.entry.data.date.toLocaleDateString(locale === 'ja' ? 'ja-JP' : 'zh-CN')}
              </p>
            </a>
          ) : (
            <p class="theme-muted mt-3 text-sm leading-6">{text.noNewerEntry}</p>
          )}
        </div>

        <div class="theme-panel rounded-[1rem] p-4">
          <p class="theme-muted text-xs uppercase tracking-[0.2em]">{text.olderEntry}</p>
          {olderEntry ? (
            <a href={articlePath(olderEntry.entry.data.category, olderEntry.slug, locale)} class="mt-3 block">
              <p class="theme-heading text-sm font-semibold leading-6">{olderEntry.entry.data.title}</p>
              <p class="theme-muted mt-2 text-xs uppercase tracking-[0.2em]">
                {olderEntry.entry.data.date.toLocaleDateString(locale === 'ja' ? 'ja-JP' : 'zh-CN')}
              </p>
            </a>
          ) : (
            <p class="theme-muted mt-3 text-sm leading-6">{text.noOlderEntry}</p>
          )}
        </div>
      </div>
    </section>

    <section class="theme-panel rounded-[1.5rem] p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="theme-muted text-xs uppercase tracking-[0.28em]">{text.sameSeries}</p>
          <h2 class="theme-heading mt-2 text-xl font-semibold">{text.sameSeries}</h2>
        </div>
        <span class="theme-chip rounded-xl px-3 py-1 text-xs">{sidebarEntries.length}</span>
      </div>
      <p class="theme-muted mt-3 text-sm leading-6">{text.sameSeriesHint}</p>

      <nav class="mt-5 grid gap-2">
        {sidebarEntries.map((item) => {
          const href = articlePath(item.entry.data.category, item.slug, locale);
          const isCurrent = item.entry.id === entry.id;

          return (
            <a
              href={href}
              aria-current={isCurrent ? 'page' : undefined}
              class:list={[
                'rounded-[0.9rem] px-3 py-3 text-sm transition',
                isCurrent ? 'theme-segment-active' : 'theme-button-soft',
              ]}
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="theme-heading line-clamp-2 font-medium leading-6">{item.entry.data.title}</p>
                  <p class="theme-muted mt-2 text-xs uppercase tracking-[0.2em]">
                    {item.entry.data.date.toLocaleDateString(locale === 'ja' ? 'ja-JP' : 'zh-CN')}
                  </p>
                </div>
                {isCurrent ? (
                  <span class="theme-chip shrink-0 rounded-xl px-2 py-1 text-[10px] uppercase tracking-[0.2em]">
                    {text.currentArticle}
                  </span>
                ) : null}
              </div>
            </a>
          );
        })}
      </nav>
    </section>
  </aside>

  <article class="theme-panel-strong rounded-[1.5rem] p-8 shadow-glow">
    <div class="theme-muted flex flex-wrap items-center gap-3 text-sm">
      <span class="theme-chip rounded-xl px-3 py-1">
        {collectionLabels[entry.data.category][locale]}
      </span>
      <time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString(locale === 'ja' ? 'ja-JP' : 'zh-CN')}</time>
      <span>·</span>
      <span>{entry.data.lang.toUpperCase()}</span>
    </div>

    <h1 class="theme-heading mt-4 text-3xl font-semibold md:text-5xl">{entry.data.title}</h1>

    {entry.data.coverImage ? (
      <div class:list={[
        'mt-8 overflow-hidden rounded-[1.25rem]',
        isGeneratedInfographic ? 'theme-panel p-4' : '',
      ]}>
        <img
          src={entry.data.coverImage}
          alt={entry.data.title}
          class:list={[
            'w-full rounded-[1rem]',
            isGeneratedInfographic ? 'max-h-[42rem] object-contain' : 'h-72 object-cover',
          ]}
        />
      </div>
    ) : null}

    {entry.data.audioUrl ? (
      <section class="theme-panel mt-6 rounded-[1.25rem] p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="theme-muted text-xs uppercase tracking-[0.24em]">
              {locale === 'ja' ? 'Audio Briefing' : 'Audio Briefing'}
            </p>
            <h2 class="theme-heading mt-2 text-lg font-semibold">
              {locale === 'ja' ? '音声解説' : '音频解读'}
            </h2>
          </div>
          <a href={entry.data.audioUrl} class="theme-chip theme-chip-link inline-flex rounded-xl px-4 py-2 text-sm">
            {locale === 'ja' ? '音声を開く' : '打开音频'}
          </a>
        </div>

        <audio controls preload="none" class="mt-4 w-full">
          <source src={entry.data.audioUrl} />
        </audio>
      </section>
    ) : null}

    <div class="mt-8 flex flex-wrap gap-2">
      {entry.data.tags.map((tag) => (
        <a href={tagPath(tag, locale)} class="theme-chip theme-chip-link rounded-xl px-3 py-1 text-sm">
          {tag}
        </a>
      ))}
    </div>

    <div class="theme-prose prose prose-slate mt-10 max-w-none prose-headings:scroll-mt-24">
      <Content />
    </div>
  </article>
</section>
