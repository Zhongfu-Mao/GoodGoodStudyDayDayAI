---
import type { CollectionEntry } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { getAcademyCatalogAnchor, getAcademyCatalogGroupName, getEntriesForLocale, getPublicTagsForEntry, getTopicsForEntry } from '../lib/content';
import {
  articlePath,
  categoryPath,
  collectionLabels,
  homePath,
  resolveSiteUrl,
  slugifyTag,
  startPath,
  stripLocaleSuffix,
  tagPath,
  topicPath,
  type CollectionName,
  type Locale,
} from '../lib/site';
import { formatDate, postDetailPage, topicCopy } from '../lib/i18n';
import {
  difficultyLabels,
  estimateReadingMinutes,
  getEntryDifficulty,
  getPlainSummary,
  readingTimeText,
} from '../lib/entryMeta';
import { formatMonthLabel, getMonthKey, resolveRadarCadence } from '../lib/radar';
import CoverPreviewDialog from './post/CoverPreviewDialog.astro';
import DeckPreviewDialog from './post/DeckPreviewDialog.astro';
import LessonNavigation from './post/LessonNavigation.astro';

type BlogEntry = CollectionEntry<CollectionName>;
type MarkdownHeading = {
  depth: number;
  slug: string;
  text: string;
};

const { locale, entry, Content, headings = [] } = Astro.props as {
  locale: Locale;
  entry: BlogEntry;
  Content: AstroComponentFactory;
  headings?: MarkdownHeading[];
};
const isGeneratedInfographic =
  typeof entry.data.coverImage === 'string' && entry.data.coverImage.includes('/images/radar/');
const isStartKnowledgeCard =
  typeof entry.data.coverImage === 'string' && entry.data.coverImage.includes('/images/start/') && entry.data.coverImage.includes('/cards/');
const coverImageSrc = entry.data.coverImage ? resolveSiteUrl(entry.data.coverImage) : undefined;
const transitionKey = entry.id.replace(/[^A-Za-z0-9_-]/g, '-');
const coverTransitionName = `cover-${transitionKey}`;
const titleTransitionName = `title-${transitionKey}`;
const audioSrc = entry.data.audioUrl ? resolveSiteUrl(entry.data.audioUrl) : undefined;
const deckHref = entry.data.deckUrl ? resolveSiteUrl(entry.data.deckUrl) : undefined;
const currentSlug = stripLocaleSuffix(entry.id, locale);
const allEntries = await getEntriesForLocale(locale);
const categoryEntries = allEntries.filter((item) => item.entry.data.category === entry.data.category);
const academyMeta = entry.data.academy;
const currentAcademyGroupName = academyMeta ? getAcademyCatalogGroupName(entry) : undefined;
const currentAcademyGroupAnchor = academyMeta ? getAcademyCatalogAnchor(entry) : '';
const tocHeadings = headings.filter((heading) => heading.depth === 2 && heading.slug && heading.text !== '参考');

function compareAcademyItems(a: (typeof categoryEntries)[number], b: (typeof categoryEntries)[number]) {
  const aOrder = a.entry.data.academy?.moduleOrder ?? Number.MAX_SAFE_INTEGER;
  const bOrder = b.entry.data.academy?.moduleOrder ?? Number.MAX_SAFE_INTEGER;

  return aOrder - bOrder || a.slug.localeCompare(b.slug, 'en');
}

const currentCadence = entry.data.category === 'radar' ? resolveRadarCadence({ slug: currentSlug, entry }) : undefined;
const sameSeriesEntries = academyMeta
  ? categoryEntries
      .filter(
        (item) =>
          item.entry.data.academy?.series === academyMeta.series &&
          getAcademyCatalogGroupName(item.entry) === currentAcademyGroupName,
      )
      .sort(compareAcademyItems)
  : entry.data.category === 'radar' && currentCadence
    ? categoryEntries.filter((item) => resolveRadarCadence(item) === currentCadence)
    : categoryEntries;
const academyLessonEntries = academyMeta
  ? categoryEntries
      .filter((item) => item.entry.data.academy?.series === academyMeta.series)
      .sort(compareAcademyItems)
  : [];
const currentSeriesIndex = sameSeriesEntries.findIndex((item) => item.entry.id === entry.id);
const newerEntry = currentSeriesIndex > 0 ? sameSeriesEntries[currentSeriesIndex - 1] : undefined;
const olderEntry =
  currentSeriesIndex !== -1 && currentSeriesIndex < sameSeriesEntries.length - 1
    ? sameSeriesEntries[currentSeriesIndex + 1]
    : undefined;
const currentLessonIndex = academyLessonEntries.findIndex((item) => item.entry.id === entry.id);
const previousLesson = currentLessonIndex > 0 ? academyLessonEntries[currentLessonIndex - 1] : undefined;
const nextLesson =
  currentLessonIndex !== -1 && currentLessonIndex < academyLessonEntries.length - 1
    ? academyLessonEntries[currentLessonIndex + 1]
    : undefined;
const showLessonNavigation = academyMeta && academyLessonEntries.length > 1;
const currentMonthKey = getMonthKey(entry.data.date);
const currentMonthLabel = formatMonthLabel(entry.data.date, locale);
const currentMonthEntries = sameSeriesEntries.filter((item) => getMonthKey(item.entry.data.date) === currentMonthKey);
const sidebarEntries = academyMeta ? sameSeriesEntries : currentMonthEntries;
const archiveHref =
  entry.data.category === 'radar' && currentCadence
    ? `${categoryPath('radar', locale)}#${currentCadence}`
    : categoryPath(entry.data.category, locale);

const text = postDetailPage[locale];
const audioPlayerText =
  locale === 'ja'
    ? {
        playMini: 'Mini Player',
        playMiniAria: '音声をサイト共通プレイヤーで再生',
      }
    : {
        playMini: '小窗播放',
        playMiniAria: '在全站播放器中播放音频',
      };
const isRadar = entry.data.category === 'radar';
const difficulty = getEntryDifficulty(entry);
const readingMinutes = estimateReadingMinutes(entry.body, locale);
const plainSummary = isRadar ? getPlainSummary(entry, locale) : '';
const publicTags = await getPublicTagsForEntry(locale, entry.data.tags);
const entryTopics = getTopicsForEntry(entry.data.tags);
const topicCopyByLocale = topicCopy[locale];
const updatedDate = entry.data.updatedDate;
const showUpdatedDate = Boolean(updatedDate && updatedDate.getTime() !== entry.data.date.getTime());
const dateLabels = locale === 'ja'
  ? { published: '公開', updated: '更新' }
  : { published: '发布', updated: '更新' };
const articleHref = articlePath(entry.data.category, currentSlug, locale);
const audioMeta = `${collectionLabels[entry.data.category][locale]} · ${formatDate(entry.data.date, locale)}`;
const openCategoryHint =
  entry.data.category === 'start'
    ? text.openCategoryHintStart
    : academyMeta
      ? text.openCategoryHintAcademy
      : text.openCategoryHintDefault;
const courseCategoryHref = entry.data.category === 'start' ? startPath(locale) : categoryPath(entry.data.category, locale);
const courseSeriesAnchor = academyMeta
  ? entry.data.category === 'start'
    ? '#ai-basics-for-everyone'
    : `#${slugifyTag(academyMeta.series)}`
  : '';
const courseModuleAnchor = academyMeta
  ? entry.data.category === 'start'
    ? '#ai-basics-for-everyone'
    : `#${currentAcademyGroupAnchor}`
  : '';
const courseSeriesHref = academyMeta ? `${courseCategoryHref}${courseSeriesAnchor}` : '';
const courseModuleHref = academyMeta ? `${courseCategoryHref}${courseModuleAnchor}` : '';
const openArchiveLabel = isRadar ? text.openArchiveRadar : text.openArchiveDefault;
const openArchiveHint = isRadar ? text.openArchiveHintRadar : text.openArchiveHintDefault;
const timelineHint = academyMeta ? text.timelineHintAcademy : text.timelineHintDefault;
const sameSeriesLabel = academyMeta ? (currentAcademyGroupName ?? text.sameSeriesAcademy) : currentMonthLabel;
const sameSeriesEyebrow = academyMeta ? text.learningTrack : sameSeriesLabel;
const sameSeriesHint = academyMeta ? text.sameSeriesHintAcademy : text.sameSeriesHintMonth;
const showTimeline = !academyMeta;
---

<section class="grid min-w-0 gap-8 sm:grid-cols-[13rem_minmax(0,1fr)] md:grid-cols-[14rem_minmax(0,1fr)] lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[17rem_minmax(0,1fr)]">
  <aside class="order-2 grid min-w-0 content-start gap-4 sm:order-1 sm:sticky sm:top-28">
    <section class="theme-panel rounded-[1.5rem] p-5">
      <p class="theme-muted text-xs uppercase tracking-[0.28em]">{text.quickJump}</p>
      <h2 class="theme-heading mt-2 text-2xl font-semibold">{collectionLabels[entry.data.category][locale]}</h2>
      <p class="theme-muted mt-3 text-sm leading-6">{openCategoryHint}</p>
      <a
        href={categoryPath(entry.data.category, locale)}
        class="theme-button-soft mt-5 inline-flex w-full items-center justify-between rounded-[1rem] px-4 py-3 text-sm"
      >
        <span>{text.openCategory}</span>
        <span aria-hidden="true">↗</span>
      </a>
      <p class="theme-muted mt-5 text-xs uppercase tracking-[0.24em]">{openArchiveHint}</p>
      <a
        href={academyMeta ? courseModuleHref : archiveHref}
        class="theme-button-soft mt-3 inline-flex w-full items-center justify-between rounded-[1rem] px-4 py-3 text-sm"
      >
        <span>{openArchiveLabel}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </section>

    {tocHeadings.length > 0 ? (
      <section class="theme-panel hidden rounded-[1.5rem] p-5 sm:block">
        <div>
          <p class="theme-muted text-xs uppercase tracking-[0.28em]">{text.tableOfContents}</p>
          <h2 class="theme-heading mt-2 text-xl font-semibold">{text.tableOfContents}</h2>
        </div>
        <p class="theme-muted mt-3 text-sm leading-6">{text.tableOfContentsHint}</p>

        <nav class="mt-5 grid gap-2">
          {tocHeadings.map((heading) => (
            <a href={`#${heading.slug}`} class="theme-button-soft rounded-[0.9rem] px-3 py-2 text-sm leading-6">
              {heading.text}
            </a>
          ))}
        </nav>
      </section>
    ) : null}

    {showTimeline ? (
      <section class="theme-panel rounded-[1.5rem] p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="theme-muted text-xs uppercase tracking-[0.28em]">{text.timeline}</p>
          <h2 class="theme-heading mt-2 text-xl font-semibold">{text.timeline}</h2>
        </div>
        <span class="theme-chip rounded-xl px-3 py-1 text-xs">{sameSeriesEntries.length}</span>
      </div>
      <p class="theme-muted mt-3 text-sm leading-6">{timelineHint}</p>

      <div class="mt-5 grid gap-3">
        <div class="theme-panel rounded-[1rem] p-4">
          <p class="theme-muted text-xs uppercase tracking-[0.2em]">{text.newerEntry}</p>
          {newerEntry ? (
            <a href={articlePath(newerEntry.entry.data.category, newerEntry.slug, locale)} class="mt-3 block">
              <p class="theme-heading text-sm font-semibold leading-6">{newerEntry.entry.data.title}</p>
              <p class="theme-muted mt-2 text-xs uppercase tracking-[0.2em]">
                {formatDate(newerEntry.entry.data.date, locale)}
              </p>
            </a>
          ) : (
            <p class="theme-muted mt-3 text-sm leading-6">{text.noNewerEntry}</p>
          )}
        </div>

        <div class="theme-panel rounded-[1rem] p-4">
          <p class="theme-muted text-xs uppercase tracking-[0.2em]">{text.olderEntry}</p>
          {olderEntry ? (
            <a href={articlePath(olderEntry.entry.data.category, olderEntry.slug, locale)} class="mt-3 block">
              <p class="theme-heading text-sm font-semibold leading-6">{olderEntry.entry.data.title}</p>
              <p class="theme-muted mt-2 text-xs uppercase tracking-[0.2em]">
                {formatDate(olderEntry.entry.data.date, locale)}
              </p>
            </a>
          ) : (
            <p class="theme-muted mt-3 text-sm leading-6">{text.noOlderEntry}</p>
          )}
        </div>
      </div>
    </section>
    ) : null}

    <section class="theme-panel rounded-[1.5rem] p-5">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="theme-muted text-xs uppercase tracking-[0.28em]">{sameSeriesEyebrow}</p>
          <h2 class="theme-heading mt-2 text-xl font-semibold">{sameSeriesLabel}</h2>
        </div>
        <span class="theme-chip rounded-xl px-3 py-1 text-xs">{sidebarEntries.length}</span>
      </div>
      <p class="theme-muted mt-3 text-sm leading-6">{sameSeriesHint}</p>

      <nav class="mt-5 grid gap-2">
        {sidebarEntries.map((item) => {
          const href = articlePath(item.entry.data.category, item.slug, locale);
          const isCurrent = item.entry.id === entry.id;

          return (
            <a
              href={href}
              aria-current={isCurrent ? 'page' : undefined}
              class:list={[
                'rounded-[0.9rem] px-3 py-3 text-sm transition',
                isCurrent ? 'theme-segment-active' : 'theme-button-soft',
              ]}
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="theme-heading line-clamp-2 font-medium leading-6">{item.entry.data.title}</p>
                  <p class="theme-muted mt-2 text-xs uppercase tracking-[0.2em]">
                    {formatDate(item.entry.data.date, locale)}
                  </p>
                </div>
                {isCurrent ? (
                  <span class="theme-chip shrink-0 rounded-xl px-2 py-1 text-[10px] uppercase tracking-[0.2em]">
                    {text.currentArticle}
                  </span>
                ) : null}
              </div>
            </a>
          );
        })}
      </nav>
    </section>
  </aside>

  <article
    class="order-1 min-w-0 theme-panel-strong rounded-[1.5rem] p-6 shadow-glow sm:order-2 sm:p-8"
    data-pagefind-body
  >
    {academyMeta ? (
      <nav class="theme-muted flex flex-wrap items-center gap-2 text-sm">
        <a href={homePath(locale)} class="transition hover:opacity-80">{text.home}</a>
        <span>/</span>
        <a href={courseCategoryHref} class="transition hover:opacity-80">
          {collectionLabels[entry.data.category][locale]}
        </a>
        <span>/</span>
        <a href={courseSeriesHref} class="transition hover:opacity-80">
          {academyMeta.series}
        </a>
        <span>/</span>
        <a href={courseModuleHref} class="transition hover:opacity-80">
          {academyMeta.module}
        </a>
        <span>/</span>
        <span>{entry.data.title}</span>
      </nav>
    ) : null}

    <div class:list={[
      'theme-muted flex flex-wrap items-center gap-3 text-sm',
      academyMeta ? 'mt-4' : '',
    ]}>
      <span class="theme-chip rounded-xl px-3 py-1">
        {collectionLabels[entry.data.category][locale]}
      </span>
      <time datetime={entry.data.date.toISOString()}>{dateLabels.published} {formatDate(entry.data.date, locale)}</time>
      {showUpdatedDate && updatedDate ? (
        <>
          <span>·</span>
          <time datetime={updatedDate.toISOString()}>{dateLabels.updated} {formatDate(updatedDate, locale)}</time>
        </>
      ) : null}
      <span>·</span>
      <span>{entry.data.lang.toUpperCase()}</span>
      <span>·</span>
      <span>{text.difficulty}: {difficultyLabels[locale][difficulty]}</span>
      <span>·</span>
      <span>{text.readingTime}: {readingTimeText[locale](readingMinutes)}</span>
    </div>

    <h1 class="theme-heading mt-4 text-3xl font-semibold md:text-5xl" transition:name={titleTransitionName}>{entry.data.title}</h1>

    {entry.data.description ? (
      <p class="theme-muted mt-4 max-w-3xl text-base leading-7 md:text-lg">{entry.data.description}</p>
    ) : null}

    {plainSummary ? (
      <section class="theme-panel mt-6 rounded-[1.25rem] p-5">
        <p class="theme-muted text-xs uppercase tracking-[0.24em]">{text.plainSummaryEyebrow}</p>
        <h2 class="theme-heading mt-2 text-xl font-semibold">{text.plainSummaryTitle}</h2>
        <p class="theme-text mt-3 text-base leading-7">{plainSummary}</p>
      </section>
    ) : null}

    {academyMeta ? (
      <section class="theme-panel mt-6 rounded-[1.25rem] p-5">
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
          <div class="grid gap-4">
            <div>
              <p class="theme-muted text-xs uppercase tracking-[0.24em]">{text.courseContext}</p>
              <h2 class="theme-heading mt-2 text-2xl font-semibold">{academyMeta.series}</h2>
              <p class="theme-muted mt-2 text-sm leading-6">{academyMeta.module}</p>
            </div>

            <div class="flex flex-wrap gap-3 text-sm">
              {academyMeta.source ? (
                <span class="theme-chip rounded-xl px-3 py-1">{academyMeta.source}</span>
              ) : null}
            </div>
          </div>

          <div class="grid gap-4">
            {academyMeta.sourceUrl ? (
              <div>
                <p class="theme-muted text-xs uppercase tracking-[0.24em]">{text.courseEntry}</p>
                <a href={academyMeta.sourceUrl} class="theme-chip theme-chip-link mt-2 inline-flex rounded-xl px-4 py-2 text-sm">
                  {text.courseEntryCta}
                </a>
              </div>
            ) : null}

            <div>
              <p class="theme-muted text-xs uppercase tracking-[0.24em]">{text.prerequisites}</p>
              {academyMeta.prerequisites.length > 0 ? (
                <ul class="theme-text mt-2 list-disc space-y-1 pl-5 text-sm">
                  {academyMeta.prerequisites.map((item) => <li>{item}</li>)}
                </ul>
              ) : (
                <p class="theme-muted mt-2 text-sm">{text.noPrerequisites}</p>
              )}
            </div>
          </div>
        </div>
      </section>
    ) : null}

    {coverImageSrc ? (
      <div class:list={[
        'theme-panel-soft relative mt-8 flex items-center justify-center overflow-hidden rounded-[1.25rem]',
        isGeneratedInfographic || isStartKnowledgeCard ? 'theme-panel p-3 sm:p-4' : 'h-72',
      ]}>
        <span class="theme-heading absolute inset-0 flex items-center justify-center text-3xl font-semibold opacity-45" aria-hidden="true">
          AI
        </span>
        <button
          type="button"
          class:list={[
            'group relative z-10 block w-full cursor-zoom-in rounded-[1rem] text-left focus:outline-none focus:ring-2 focus:ring-cyan-300/70',
            isGeneratedInfographic || isStartKnowledgeCard ? 'leading-none' : '',
          ]}
          data-cover-preview-trigger
          aria-label={text.coverPreviewOpen}
        >
          <img
            src={coverImageSrc}
            alt={entry.data.title}
            transition:name={coverTransitionName}
            class:list={[
              'block w-full rounded-[1rem] transition duration-200 group-hover:brightness-110',
              isGeneratedInfographic || isStartKnowledgeCard ? 'h-auto object-contain' : 'h-72 object-cover',
            ]}
            onerror="this.setAttribute('hidden', 'hidden')"
          />
        </button>
      </div>
    ) : null}

    {audioSrc ? (
      <section
        class="theme-panel mt-6 rounded-[1.25rem] p-5"
        data-audio-briefing
        data-audio-src={audioSrc}
        data-audio-title={entry.data.title}
        data-audio-meta={audioMeta}
        data-audio-cover={coverImageSrc ?? ''}
        data-audio-href={articleHref}
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="theme-muted text-xs uppercase tracking-[0.24em]">{text.audioBriefingEyebrow}</p>
            <h2 class="theme-heading mt-2 text-lg font-semibold">{text.audioBriefingTitle}</h2>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              class="theme-action-primary ui-tooltip inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold"
              data-audio-play-trigger
              data-tooltip={audioPlayerText.playMiniAria}
              aria-label={audioPlayerText.playMiniAria}
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                <path d="M8 5.2v13.6c0 .7.8 1.1 1.4.7l9.5-6.8c.5-.3.5-1.1 0-1.4L9.4 4.5C8.8 4.1 8 4.5 8 5.2Z" />
              </svg>
              <span>{audioPlayerText.playMini}</span>
            </button>
          </div>
        </div>

        <noscript>
          <audio controls preload="none" class="mt-4 w-full">
            <source src={audioSrc} />
          </audio>
        </noscript>
      </section>
    ) : null}

    {deckHref ? (
      <section class="theme-panel mt-6 rounded-[1.25rem] p-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <p class="theme-muted text-xs uppercase tracking-[0.24em]">{text.slideDeckEyebrow}</p>
            <h2 class="theme-heading mt-2 text-lg font-semibold">{text.slideDeckTitle}</h2>
          </div>
          <button
            type="button"
            class="theme-chip theme-chip-link inline-flex rounded-xl px-4 py-2 text-sm"
            data-deck-preview-trigger
            aria-label={text.slideDeckOpen}
          >
            {text.slideDeckOpen}
          </button>
        </div>
      </section>
    ) : null}

    {coverImageSrc ? (
      <CoverPreviewDialog src={coverImageSrc} alt={entry.data.title} closeLabel={text.coverPreviewClose} />
    ) : null}

    {deckHref ? (
      <DeckPreviewDialog
        href={deckHref}
        title={entry.data.title}
        text={{
          eyebrow: text.slideDeckEyebrow,
          close: text.slideDeckClose,
          previous: text.slideDeckPrevious,
          next: text.slideDeckNext,
          loading: text.slideDeckLoading,
          error: text.slideDeckError,
          pageStatus: text.slideDeckPageStatus,
          deckTitle: text.slideDeckTitle,
        }}
      />
    ) : null}

    {entryTopics.length > 0 ? (
      <div class="mt-8 flex flex-wrap items-center gap-2">
        <span class="theme-muted text-xs uppercase tracking-[0.24em]">{text.topicLabel}</span>
        {entryTopics.map((topic) => (
          <a
            href={topicPath(topic, locale)}
            class="theme-chip theme-chip-link rounded-xl px-3 py-1 text-sm font-semibold"
          >
            {topicCopyByLocale[topic].label}
          </a>
        ))}
      </div>
    ) : null}

    {publicTags.length > 0 ? (
      <div class="mt-4 flex flex-wrap gap-2">
        {publicTags.map((tag) => (
          <a href={tagPath(tag, locale)} class="theme-chip theme-chip-link rounded-xl px-3 py-1 text-sm">
            {tag}
          </a>
        ))}
      </div>
    ) : null}

    {tocHeadings.length > 0 ? (
      <section class="theme-panel mt-6 rounded-[1.25rem] p-5 sm:hidden">
        <p class="theme-muted text-xs uppercase tracking-[0.24em]">{text.tableOfContents}</p>
        <h2 class="theme-heading mt-2 text-lg font-semibold">{text.tableOfContents}</h2>
        <nav class="mt-4 grid gap-2">
          {tocHeadings.map((heading) => (
            <a href={`#${heading.slug}`} class="theme-button-soft rounded-[0.9rem] px-3 py-2 text-sm leading-6">
              {heading.text}
            </a>
          ))}
        </nav>
      </section>
    ) : null}

    <div class="theme-prose prose mt-10 max-w-none prose-headings:scroll-mt-24">
      <Content />
    </div>

    {showLessonNavigation ? (
      <LessonNavigation
        locale={locale}
        previousLesson={previousLesson}
        nextLesson={nextLesson}
        currentLessonIndex={currentLessonIndex}
        totalLessons={academyLessonEntries.length}
        courseModuleHref={courseModuleHref}
        text={{
          lessonNavEyebrow: text.lessonNavEyebrow,
          lessonNavTitle: text.lessonNavTitle,
          lessonNavHint: text.lessonNavHint,
          previousLesson: text.previousLesson,
          nextLesson: text.nextLesson,
          openLesson: text.openLesson,
          firstLesson: text.firstLesson,
          lastLesson: text.lastLesson,
          backToModule: text.backToModule,
        }}
      />
    ) : null}
  </article>
</section>
