---
import PostCard from './PostCard.astro';
import { tagIndexPath, type Locale } from '../lib/site';
import { getEntriesForTag, getTagIndex } from '../lib/content';
import { tagDetailPage } from '../lib/i18n';

const { locale, tagSlug } = Astro.props as { locale: Locale; tagSlug: string };
const [tagIndex, entries] = await Promise.all([getTagIndex(locale), getEntriesForTag(locale, tagSlug)]);
const tag = tagIndex.find((item) => item.slug === tagSlug);
const label = tag?.label ?? tagSlug;
const text = tagDetailPage[locale];
---

<section class="theme-panel-strong rounded-[1.5rem] p-8 shadow-glow">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{text.title}</p>
      <h1 class="theme-heading mt-3 text-3xl font-semibold">{label}</h1>
      <p class="theme-muted mt-3">/{tagSlug}</p>
    </div>
    <a href={tagIndexPath(locale)} class="theme-panel theme-panel-link rounded-2xl px-4 py-2 text-sm">
      {text.back}
    </a>
  </div>

  <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {entries.length > 0 ? entries.map((item) => <PostCard item={item} locale={locale} />) : <p class="theme-muted">{text.empty}</p>}
  </div>
</section>
