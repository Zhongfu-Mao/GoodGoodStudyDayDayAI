---
import type { CollectionEntry } from 'astro:content';
import { articlePath, type CollectionName, type Locale } from '../../lib/site';

type LessonItem = {
  entry: CollectionEntry<CollectionName>;
  slug: string;
};

interface Props {
  locale: Locale;
  previousLesson: LessonItem | undefined;
  nextLesson: LessonItem | undefined;
  currentLessonIndex: number;
  totalLessons: number;
  courseModuleHref: string;
  text: {
    lessonNavEyebrow: string;
    lessonNavTitle: string;
    lessonNavHint: string;
    previousLesson: string;
    nextLesson: string;
    openLesson: string;
    firstLesson: string;
    lastLesson: string;
    backToModule: string;
  };
}

const { locale, previousLesson, nextLesson, currentLessonIndex, totalLessons, courseModuleHref, text } =
  Astro.props;

function getLessonTitle(item: LessonItem) {
  const title = item.entry.data.title;
  const series = item.entry.data.academy?.series;

  if (!series) {
    return title;
  }

  for (const separator of ['：', ':']) {
    const prefix = `${series}${separator}`;

    if (title.startsWith(prefix)) {
      return title.slice(prefix.length).trim();
    }
  }

  return title;
}
---

<section class="theme-panel mt-10 rounded-[1.25rem] p-5" data-course-navigation>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="theme-muted text-xs uppercase tracking-[0.24em]">{text.lessonNavEyebrow}</p>
      <h2 class="theme-heading mt-2 text-2xl font-semibold">{text.lessonNavTitle}</h2>
      <p class="theme-muted mt-2 max-w-2xl text-sm leading-6">{text.lessonNavHint}</p>
    </div>
    <span class="theme-chip rounded-xl px-3 py-1 text-xs">
      {currentLessonIndex + 1} / {totalLessons}
    </span>
  </div>

  <div class="mt-5 grid gap-3 md:grid-cols-2">
    {previousLesson ? (
      <a
        href={articlePath(previousLesson.entry.data.category, previousLesson.slug, locale)}
        class="theme-button-soft group flex min-h-36 flex-col justify-between rounded-[1.1rem] p-4"
        aria-label={`${text.previousLesson}: ${getLessonTitle(previousLesson)}`}
      >
        <span class="theme-muted text-xs uppercase tracking-[0.22em]">{text.previousLesson}</span>
        <span class="theme-heading mt-3 line-clamp-3 text-lg font-semibold leading-7">
          {getLessonTitle(previousLesson)}
        </span>
        <span class="theme-muted mt-4 inline-flex items-center gap-2 text-sm">
          <span aria-hidden="true">←</span>
          <span>{text.openLesson}</span>
        </span>
      </a>
    ) : (
      <a
        href={courseModuleHref}
        class="theme-button-soft flex min-h-36 flex-col justify-between rounded-[1.1rem] p-4"
      >
        <span class="theme-muted text-xs uppercase tracking-[0.22em]">{text.previousLesson}</span>
        <span class="theme-heading mt-3 text-lg font-semibold leading-7">{text.firstLesson}</span>
        <span class="theme-muted mt-4 inline-flex items-center gap-2 text-sm">
          <span aria-hidden="true">↑</span>
          <span>{text.backToModule}</span>
        </span>
      </a>
    )}

    {nextLesson ? (
      <a
        href={articlePath(nextLesson.entry.data.category, nextLesson.slug, locale)}
        class="theme-action-primary group flex min-h-36 flex-col justify-between rounded-[1.1rem] p-4"
        aria-label={`${text.nextLesson}: ${getLessonTitle(nextLesson)}`}
      >
        <span class="text-xs uppercase tracking-[0.22em] opacity-80">{text.nextLesson}</span>
        <span class="mt-3 line-clamp-3 text-lg font-semibold leading-7">{getLessonTitle(nextLesson)}</span>
        <span class="mt-4 inline-flex items-center gap-2 text-sm opacity-90">
          <span>{text.openLesson}</span>
          <span aria-hidden="true">→</span>
        </span>
      </a>
    ) : (
      <a
        href={courseModuleHref}
        class="theme-button-soft flex min-h-36 flex-col justify-between rounded-[1.1rem] p-4"
      >
        <span class="theme-muted text-xs uppercase tracking-[0.22em]">{text.nextLesson}</span>
        <span class="theme-heading mt-3 text-lg font-semibold leading-7">{text.lastLesson}</span>
        <span class="theme-muted mt-4 inline-flex items-center gap-2 text-sm">
          <span>{text.backToModule}</span>
          <span aria-hidden="true">↑</span>
        </span>
      </a>
    )}
  </div>
</section>
