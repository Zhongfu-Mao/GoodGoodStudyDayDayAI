---
interface Props {
  src: string;
  alt: string;
  closeLabel: string;
}

const { src, alt, closeLabel } = Astro.props;
---

<dialog
  class="h-[calc(100dvh-2rem)] max-h-none w-[calc(100vw-2rem)] max-w-none rounded-[1.25rem] border-0 bg-transparent p-0 backdrop:bg-slate-950/75"
  data-cover-preview-dialog
>
  <div class="relative grid h-full place-items-center overflow-hidden rounded-[1.25rem] bg-slate-950/35 p-4 shadow-glow md:p-8">
    <img
      src={src}
      alt={alt}
      class="max-h-full max-w-full rounded-[1rem] object-contain shadow-2xl"
      data-cover-preview-image
    />
    <button
      type="button"
      class="absolute right-4 top-4 inline-flex h-11 min-w-11 items-center justify-center gap-2 rounded-xl border border-white/20 bg-slate-950/85 px-3 text-sm font-semibold text-white shadow-2xl backdrop-blur transition hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-white/70 md:right-6 md:top-6 md:px-4"
      data-cover-preview-close
      aria-label={closeLabel}
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="m6 6 12 12" />
        <path d="m18 6-12 12" />
      </svg>
      <span class="hidden sm:inline">{closeLabel}</span>
    </button>
  </div>
</dialog>

<script is:inline data-astro-rerun>
  (function () {
    function showDialog(dialog) {
      if (!dialog) return;
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
    }

    function closeDialog(dialog) {
      if (!dialog) return;
      if (typeof dialog.close === 'function') {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
    }

    var coverTrigger = document.querySelector('[data-cover-preview-trigger]');
    var coverDialog = document.querySelector('[data-cover-preview-dialog]');
    var coverClose = document.querySelector('[data-cover-preview-close]');

    if (coverTrigger && coverDialog && coverTrigger.dataset.previewBound !== 'true') {
      coverTrigger.dataset.previewBound = 'true';
      coverTrigger.addEventListener('click', function () {
        showDialog(coverDialog);
      });
      coverClose?.addEventListener('click', function () {
        closeDialog(coverDialog);
      });
      coverDialog.addEventListener('click', function (event) {
        if (event.target === coverDialog) closeDialog(coverDialog);
      });
    }
  })();
</script>
