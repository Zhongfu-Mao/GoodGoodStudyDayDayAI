---
import PostCard from './PostCard.astro';
import { collectionLabels, topicIndexPath, type CollectionName, type Locale } from '../lib/site';
import { getEntriesForTopic } from '../lib/content';
import { topicCopy, topicsPage } from '../lib/i18n';
import type { Topic } from '../lib/topics';

const { locale, topic } = Astro.props as { locale: Locale; topic: Topic };
const entries = await getEntriesForTopic(locale, topic);
const text = topicsPage[locale];
const copy = topicCopy[locale][topic];

// How many cards to surface per collection before the "show all" toggle.
const PREVIEW_PER_COLLECTION = 6;

// Group by collection so a Topic page surfaces the cross-cut nature.
const COLLECTION_ORDER: CollectionName[] = ['radar', 'academy', 'engineering', 'foundations', 'start'];
const grouped = new Map<CollectionName, typeof entries>();
for (const item of entries) {
  const list = grouped.get(item.entry.data.category) ?? [];
  list.push(item);
  grouped.set(item.entry.data.category, list);
}
const orderedGroups = COLLECTION_ORDER.flatMap((collection) => {
  const items = grouped.get(collection);
  if (!items || items.length === 0) return [];
  const preview = items.slice(0, PREVIEW_PER_COLLECTION);
  const overflow = items.slice(PREVIEW_PER_COLLECTION);
  return [{ collection, items, preview, overflow }];
});
const distributionItems = COLLECTION_ORDER.map((collection) => ({
  collection,
  label: collectionLabels[collection][locale],
  count: grouped.get(collection)?.length ?? 0,
}));
---

<section class="theme-panel-strong rounded-[1.5rem] p-8 shadow-glow">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{text.detailEyebrow}</p>
      <h1 class="theme-heading mt-3 text-3xl font-semibold md:text-4xl">{copy.label}</h1>
      <p class="theme-muted mt-3 max-w-3xl text-base leading-7">{copy.description}</p>
    </div>
    <a href={topicIndexPath(locale)} class="theme-panel theme-panel-link rounded-2xl px-4 py-2 text-sm">
      {text.backToIndex}
    </a>
  </div>

  {entries.length === 0 ? (
    <p class="theme-muted mt-8">{text.emptyTopic}</p>
  ) : (
    <div class="mt-10 grid gap-10">
      <section class="theme-panel rounded-[1.25rem] p-5" data-topic-distribution>
        <p class="theme-muted text-xs font-semibold uppercase tracking-[0.22em]">{text.distributionTitle}</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          {distributionItems.map((item) => (
            <div class="theme-panel rounded-[1rem] px-4 py-3" data-topic-distribution-item={item.collection}>
              <span class="theme-muted block text-xs uppercase tracking-[0.16em]">{item.label}</span>
              <span class="theme-heading mt-1 block text-lg font-semibold">{text.itemCount(item.count)}</span>
            </div>
          ))}
        </div>
      </section>

      {orderedGroups.map(({ collection, items, preview, overflow }) => (
        <section>
          <div class="flex flex-wrap items-end justify-between gap-3">
            <h2 class="theme-heading text-xl font-semibold">
              {text.detailFromCollection(collectionLabels[collection][locale])}
            </h2>
            <span class="theme-chip rounded-xl px-3 py-1 text-xs">{text.itemCount(items.length)}</span>
          </div>
          <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
            {preview.map((item) => <PostCard item={item} locale={locale} />)}
            {overflow.length > 0 ? (
              <details class="topic-show-more col-span-full">
                <summary class="topic-show-more__summary theme-button-soft flex cursor-pointer items-center justify-center gap-2 rounded-[1rem] px-4 py-3 text-sm font-medium">
                  <span class="topic-show-more__chevron" aria-hidden="true">▾</span>
                  <span class="topic-show-more__label-collapsed">
                    {text.showAll(items.length)}
                  </span>
                  <span class="topic-show-more__label-expanded">
                    {text.collapse}
                  </span>
                </summary>
                <div class="mt-5 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                  {overflow.map((item) => <PostCard item={item} locale={locale} />)}
                </div>
              </details>
            ) : null}
          </div>
        </section>
      ))}
    </div>
  )}
</section>

<style>
  .topic-show-more__summary::-webkit-details-marker {
    display: none;
  }

  .topic-show-more__chevron {
    display: inline-block;
    transition: transform 0.18s ease;
  }

  details[open] > .topic-show-more__summary .topic-show-more__chevron {
    transform: rotate(180deg);
  }

  .topic-show-more__label-expanded {
    display: none;
  }

  details[open] > .topic-show-more__summary .topic-show-more__label-collapsed {
    display: none;
  }

  details[open] > .topic-show-more__summary .topic-show-more__label-expanded {
    display: inline;
  }
</style>
