---
import { tagPath, type Locale } from '../lib/site';
import { getTagIndex } from '../lib/content';

const { locale } = Astro.props as { locale: Locale };
const tags = await getTagIndex(locale);

const copy = {
  zh: {
    title: '标签总览',
    description: '按标签浏览全部文章。',
  },
  ja: {
    title: 'タグ一覧',
    description: 'タグごとに記事を一覧できます。',
  },
} as const;

const text = copy[locale];
---

<section class="theme-panel-strong rounded-[1.5rem] p-8 shadow-glow">
  <p class="theme-kicker text-sm uppercase tracking-[0.24em]">{text.title}</p>
  <h1 class="theme-heading mt-3 text-3xl font-semibold">{text.title}</h1>
  <p class="theme-muted mt-4 max-w-2xl">{text.description}</p>

  <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {tags.map((tag) => (
      <a href={tagPath(tag.label, locale)} class="theme-panel theme-panel-link rounded-[1.25rem] p-5">
        <div class="flex items-center justify-between gap-4">
          <span class="theme-heading text-lg font-semibold">{tag.label}</span>
          <span class="theme-chip rounded-xl px-3 py-1 text-xs">{tag.count}</span>
        </div>
        <p class="theme-muted mt-2 text-sm">/{tag.slug}</p>
      </a>
    ))}
  </div>
</section>
