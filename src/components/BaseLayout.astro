---
import { ClientRouter } from 'astro:transitions';
import Analytics from './Analytics.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import PersistentAudioPlayer from './PersistentAudioPlayer.astro';
import SearchForm from './SearchForm.astro';
import SiteNav from './SiteNav.astro';
import ThemeToggle from './ThemeToggle.astro';
import {
  cadenceLabels,
  categoryPath,
  homePath,
  resolveSiteUrl,
  startPath,
  withBase,
  type CollectionName,
  type Locale,
} from '../lib/site';
import { baseLayout, homePage } from '../lib/i18n';
import '../styles/global.css';

const {
  title,
  description: providedDescription,
  locale = 'zh',
  languagePaths,
  ogType = 'website',
  ogImage,
  publishedTime,
  activeCategory,
  showStartSubnav = false,
} = Astro.props as {
  title: string;
  description?: string;
  locale?: Locale;
  languagePaths?: Partial<Record<Locale, string>>;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  activeCategory?: CollectionName;
  showStartSubnav?: boolean;
};

const description = providedDescription ?? homePage[locale].description;
const taglineLines = baseLayout[locale].taglineLines;
const tagline = taglineLines.join('');
const ogLocale = locale === 'ja' ? 'ja_JP' : 'zh_CN';
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : (Astro.site ? new URL(resolveSiteUrl(ogImage), Astro.site).toString() : resolveSiteUrl(ogImage)))
  : undefined;
const rssHref = withBase(locale === 'ja' ? '/ja/rss.xml' : '/rss.xml');
const rssTitle = locale === 'ja' ? 'Good Good Study, Day Day AI – RSS' : 'Good Good Study, Day Day AI · RSS';
const showRadarSubnav = activeCategory === 'radar';
const radarSubnavTooltips = {
  zh: {
    daily: '每天快速扫一遍模型、产品与实践动态',
    weekly: '按周复盘主题脉络和关键变化',
    monthly: '看月度趋势、结构变化和长期信号',
  },
  ja: {
    daily: '日々のモデル、プロダクト、実践動向を素早く確認',
    weekly: '週ごとのテーマ、流れ、重要変化を振り返る',
    monthly: '月次のトレンド、構造変化、長期シグナルを見る',
  },
};
const radarSubnavItems = [
  {
    href: `${categoryPath('radar', locale)}#daily`,
    hash: '#daily',
    label: cadenceLabels.daily[locale],
    tooltip: radarSubnavTooltips[locale].daily,
  },
  {
    href: `${categoryPath('radar', locale)}#weekly`,
    hash: '#weekly',
    label: cadenceLabels.weekly[locale],
    tooltip: radarSubnavTooltips[locale].weekly,
  },
  {
    href: `${categoryPath('radar', locale)}#monthly`,
    hash: '#monthly',
    label: cadenceLabels.monthly[locale],
    tooltip: radarSubnavTooltips[locale].monthly,
  },
];
const startSubnavItems = locale === 'ja'
  ? [
      { hash: '#start-route', label: '道筋', tooltip: '現在地を確認し、30/60/90 日の進め方を決める' },
      { hash: '#ai-basics-for-everyone', label: '概念', tooltip: '12 本の短文で頻出概念を押さえる' },
      { hash: '#start-layers', label: 'レイヤー', tooltip: '日常利用から Agent までの能力層を整理する' },
      { hash: '#start-safety', label: '安全', tooltip: 'よくある誤解を避け、安全な使い方の境界を作る' },
      { hash: '#start-faq', label: 'FAQ', tooltip: '初心者がつまずきやすい疑問を先に解く' },
    ]
  : [
      { hash: '#start-route', label: '路线', tooltip: '先判断当前位置，安排 30/60/90 天学习节奏' },
      { hash: '#ai-basics-for-everyone', label: '概念', tooltip: '用 12 篇短文打底高频概念' },
      { hash: '#start-layers', label: '能力层', tooltip: '看清从日常使用到 Agent 的能力层' },
      { hash: '#start-safety', label: '安全', tooltip: '避开常见误区，建立安全使用边界' },
      { hash: '#start-faq', label: 'FAQ', tooltip: '快速回答新手最容易卡住的问题' },
    ];
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <link rel="alternate" type="application/rss+xml" title={rssTitle} href={rssHref} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Good Good Study, Day Day AI" />
    <meta property="og:locale" content={ogLocale} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    {resolvedOgImage ? <meta property="og:image" content={resolvedOgImage} /> : null}
    {ogType === 'article' && publishedTime ? (
      <meta property="article:published_time" content={publishedTime} />
    ) : null}

    <meta name="twitter:card" content={resolvedOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage ? <meta name="twitter:image" content={resolvedOgImage} /> : null}
    <ClientRouter />
    <Analytics />
    <script is:inline data-astro-rerun>
      (function () {
        var storageKey = 'ggsdda-theme';
        function readStoredTheme() {
          try {
            return localStorage.getItem(storageKey);
          } catch (error) {
            return null;
          }
        }

        function getSystemTheme() {
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }

        var theme = readStoredTheme() || getSystemTheme();
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class="theme-page min-h-screen antialiased">
    <div class="theme-grid fixed inset-0 -z-10 bg-[size:72px_72px] [mask-image:radial-gradient(ellipse_at_center,black_25%,transparent_75%)]" />
    <div class="theme-divider-line fixed inset-x-0 top-0 -z-10 h-px" />

    <header class="theme-panel-strong sticky top-0 z-20 backdrop-blur-xl">
      <div class="flex w-full items-center justify-between gap-3 px-4 py-4 sm:px-6 xl:grid xl:grid-cols-[minmax(12rem,16rem)_minmax(0,1fr)_auto] xl:items-center xl:gap-3 xl:px-6 2xl:grid-cols-[minmax(16.5rem,21rem)_minmax(0,1fr)_auto] 2xl:gap-4 2xl:px-8">
        <a href={homePath(locale)} class="group flex min-w-0 flex-1 items-center gap-2.5 xl:max-w-[21rem] xl:justify-self-start">
          <span class="theme-brand-badge grid h-10 w-10 place-items-center rounded-xl border text-sm font-semibold">
            AI
          </span>
          <div class="min-w-0 flex-1 xl:max-w-[16.5rem] 2xl:max-w-[19rem]">
            <p class="truncate text-sm font-semibold tracking-wide theme-text xl:text-[13px]">Good Good Study, Day Day AI</p>
            <p class="hidden max-w-[34rem] text-xs leading-4 theme-muted sm:block xl:max-w-[16.5rem] 2xl:max-w-[19rem]">{tagline}</p>
          </div>
        </a>

        <div class="hidden min-w-0 items-center justify-center xl:flex xl:px-4 2xl:px-6">
          <div class="min-w-0 w-full">
            <SiteNav locale={locale} showSearch={false} />
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-2 xl:justify-self-end 2xl:gap-3">
          <div class="hidden xl:block">
            <SearchForm locale={locale} placement="header" />
          </div>
          <ThemeToggle />
          <LanguageSwitcher paths={languagePaths} />
        </div>
      </div>
      <div class="px-6 pb-4 xl:hidden">
        <SiteNav locale={locale} />
      </div>
      {showRadarSubnav ? (
        <div class="border-t border-[color:var(--theme-border)] px-6 pb-3 pt-2 xl:px-8">
          <nav class="flex flex-wrap justify-center gap-2" aria-label={locale === 'ja' ? 'AI Radar sections' : 'AI 雷达二级导航'}>
            {radarSubnavItems.map((item) => (
              <a
                href={item.href}
                data-radar-subnav={item.hash}
                data-tooltip={item.tooltip}
                class="theme-chip theme-chip-link ui-tooltip ui-tooltip-bottom rounded-xl px-3.5 py-1.5 text-sm"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      ) : null}
      {showStartSubnav ? (
        <div class="border-t border-[color:var(--theme-border)] px-6 pb-3 pt-2 xl:px-8">
          <nav class="flex flex-wrap justify-center gap-2" aria-label={locale === 'ja' ? 'Start guide sections' : '新手起步分段导航'}>
            {startSubnavItems.map((item) => (
              <a
                href={`${startPath(locale)}${item.hash}`}
                data-start-subnav={item.hash}
                data-tooltip={item.tooltip}
                class="theme-chip theme-chip-link ui-tooltip ui-tooltip-bottom rounded-xl px-3.5 py-1.5 text-sm"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      ) : null}
    </header>

    <main class="mx-auto max-w-6xl px-6 py-10">
      <slot />
    </main>
    <PersistentAudioPlayer />
    <script is:inline data-astro-rerun>
      (function () {
        var storageKey = 'ggsdda-theme';

        function readStoredTheme() {
          try {
            return localStorage.getItem(storageKey);
          } catch (error) {
            return null;
          }
        }

        function writeStoredTheme(theme) {
          try {
            localStorage.setItem(storageKey, theme);
          } catch (error) {}
        }

        function getSystemTheme() {
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }

        function applyTheme(theme) {
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;

          document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
            var lightIcon = button.querySelector('[data-theme-icon-light]');
            var darkIcon = button.querySelector('[data-theme-icon-dark]');
            var isJapanese = document.documentElement.lang === 'ja';
            var label = theme === 'light'
              ? (isJapanese ? 'ダークモードに切り替え' : '切换到深色模式')
              : (isJapanese ? 'ライトモードに切り替え' : '切换到浅色模式');

            if (lightIcon) lightIcon.classList.toggle('hidden', theme === 'light');
            if (darkIcon) darkIcon.classList.toggle('hidden', theme !== 'light');

            button.setAttribute('aria-label', label);
            button.setAttribute('data-tooltip', label);
          });
        }

        function bindToggle(button) {
          if (button.dataset.themeBound === 'true') return;
          button.dataset.themeBound = 'true';

          button.addEventListener('click', function () {
            var nextTheme = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
            writeStoredTheme(nextTheme);
            applyTheme(nextTheme);
          });
        }

        function initThemeControls() {
          applyTheme(readStoredTheme() || getSystemTheme());
          document.querySelectorAll('[data-theme-toggle]').forEach(bindToggle);
        }

        var mediaQuery = window.matchMedia ? window.matchMedia('(prefers-color-scheme: light)') : null;
        if (mediaQuery && mediaQuery.addEventListener) {
          mediaQuery.addEventListener('change', function () {
            if (!readStoredTheme()) {
              applyTheme(getSystemTheme());
            }
          });
        }

        window.addEventListener('storage', function (event) {
          if (event.key === storageKey) {
            applyTheme(event.newValue || getSystemTheme());
          }
        });

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initThemeControls, { once: true });
        } else {
          initThemeControls();
        }
      })();
    </script>
  </body>
</html>
