---
import { ClientRouter } from 'astro:transitions';
import Analytics from './Analytics.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import PersistentAudioPlayer from './PersistentAudioPlayer.astro';
import SearchForm from './SearchForm.astro';
import SiteNav from './SiteNav.astro';
import ThemeToggle from './ThemeToggle.astro';
import ThemeScript from './ThemeScript.astro';
import {
  homePath,
  resolveSiteUrl,
  searchPath,
  withBase,
  type CollectionName,
  type Locale,
} from '../lib/site';
import { baseLayout, homePage, siteNav } from '../lib/i18n';
import { getAcademySubnavItems, getRadarSubnavItems, getStartSubnavItems } from '../lib/navigation';
import '../styles/global.css';

const {
  title,
  description: providedDescription,
  locale = 'zh',
  languagePaths,
  ogType = 'website',
  ogImage,
  publishedTime,
  modifiedTime,
  activeCategory,
  showStartSubnav = false,
  structuredData,
} = Astro.props as {
  title: string;
  description?: string;
  locale?: Locale;
  languagePaths?: Partial<Record<Locale, string>>;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  activeCategory?: CollectionName;
  showStartSubnav?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
};

const description = providedDescription ?? homePage[locale].description;
const taglineLines = baseLayout[locale].taglineLines;
const tagline = taglineLines.join('');
const ogLocale = locale === 'ja' ? 'ja_JP' : 'zh_CN';
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const resolvedOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : (Astro.site ? new URL(resolveSiteUrl(ogImage), Astro.site).toString() : resolveSiteUrl(ogImage)))
  : undefined;
const rssHref = withBase(locale === 'ja' ? '/ja/rss.xml' : '/rss.xml');
const rssTitle = locale === 'ja' ? 'Good Good Study, Day Day AI – RSS' : 'Good Good Study, Day Day AI · RSS';
const skipLinkLabel = locale === 'ja' ? '本文へ移動' : '跳到正文';
const structuredDataJson = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
const showRadarSubnav = activeCategory === 'radar';
const showAcademySubnav = activeCategory === 'academy';
const radarSubnavItems = getRadarSubnavItems(locale);
const academySubnavItems = getAcademySubnavItems(locale);
const startSubnavItems = getStartSubnavItems(locale);
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <link rel="alternate" type="application/rss+xml" title={rssTitle} href={rssHref} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Good Good Study, Day Day AI" />
    <meta property="og:locale" content={ogLocale} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    {resolvedOgImage ? <meta property="og:image" content={resolvedOgImage} /> : null}
    {ogType === 'article' && publishedTime ? (
      <meta property="article:published_time" content={publishedTime} />
    ) : null}
    {ogType === 'article' && modifiedTime ? (
      <meta property="article:modified_time" content={modifiedTime} />
    ) : null}

    <meta name="twitter:card" content={resolvedOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage ? <meta name="twitter:image" content={resolvedOgImage} /> : null}
    {structuredDataJson ? <script is:inline type="application/ld+json" set:html={structuredDataJson}></script> : null}
    <ClientRouter />
    <Analytics />
    <ThemeScript />
    <title>{title}</title>
  </head>
  <body class="theme-page min-h-screen antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-xl focus:bg-[var(--theme-page-text)] focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-[var(--theme-page-bg)] focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-[var(--theme-accent)]"
    >
      {skipLinkLabel}
    </a>
    <div class="theme-grid fixed inset-0 -z-10 bg-[size:72px_72px] [mask-image:radial-gradient(ellipse_at_center,black_25%,transparent_75%)]" />
    <div class="theme-divider-line fixed inset-x-0 top-0 -z-10 h-px" />

    <header class="theme-panel-strong sticky top-0 z-20 backdrop-blur-xl">
      <div class="flex w-full items-center justify-between gap-3 px-4 py-4 sm:px-6 xl:grid xl:grid-cols-[minmax(12rem,16rem)_minmax(0,1fr)_auto] xl:items-center xl:gap-3 xl:px-6 2xl:grid-cols-[minmax(16.5rem,21rem)_minmax(0,1fr)_auto] 2xl:gap-4 2xl:px-8">
        <a href={homePath(locale)} class="group flex min-w-0 flex-1 items-center gap-2.5 xl:max-w-[21rem] xl:justify-self-start">
          <span class="theme-brand-badge grid h-10 w-10 place-items-center rounded-xl border text-sm font-semibold">
            AI
          </span>
          <div class="min-w-0 flex-1 xl:max-w-[16.5rem] 2xl:max-w-[19rem]">
            <p class="truncate text-sm font-semibold tracking-wide theme-text xl:text-[13px]">Good Good Study, Day Day AI</p>
            <p class="hidden max-w-[34rem] text-xs leading-4 theme-muted sm:block xl:max-w-[16.5rem] 2xl:max-w-[19rem]">{tagline}</p>
          </div>
        </a>

        <div class="hidden min-w-0 items-center justify-center xl:flex xl:px-4 2xl:px-6">
          <div class="min-w-0 w-full">
            <SiteNav locale={locale} showSearch={false} />
          </div>
        </div>

        <div class="flex shrink-0 items-center gap-2 xl:justify-self-end 2xl:gap-3">
          <div class="hidden xl:block">
            <SearchForm locale={locale} placement="header" />
          </div>
          <a
            href={searchPath(locale)}
            class="theme-toggle ui-tooltip ui-tooltip-bottom inline-grid h-11 w-11 place-items-center rounded-2xl xl:hidden"
            data-mobile-search-link
            data-tooltip={siteNav[locale].search}
            aria-label={siteNav[locale].search}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
          </a>
          <ThemeToggle />
          <LanguageSwitcher paths={languagePaths} />
        </div>
      </div>
      <div class="px-4 pb-3 sm:px-6 xl:hidden">
        <SiteNav locale={locale} showSearch={false} />
      </div>
      {showRadarSubnav ? (
        <div class="border-t border-[color:var(--theme-border)] px-6 pb-3 pt-2 xl:px-8">
          <nav class="flex flex-wrap items-center justify-center gap-2" aria-label={locale === 'ja' ? 'AI Radar sections' : 'AI 雷达二级导航'}>
            <span class="theme-muted mr-1 text-xs font-semibold uppercase tracking-[0.18em]">
              {locale === 'ja' ? '周期で見る' : '按周期浏览'}
            </span>
            {radarSubnavItems.map((item) => (
              <a
                href={item.href}
                data-radar-subnav={item.hash}
                data-tooltip={item.tooltip}
                class="theme-chip theme-chip-link ui-tooltip ui-tooltip-bottom rounded-xl px-3.5 py-1.5 text-sm"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      ) : null}
      {showAcademySubnav ? (
        <div class="border-t border-[color:var(--theme-border)] px-6 pb-3 pt-2 xl:px-8">
          <nav class="flex flex-wrap justify-center gap-2" aria-label={locale === 'ja' ? 'AI Academy sections' : 'AI Academy 二级导航'}>
            {academySubnavItems.map((item) => (
              <a
                href={item.href}
                data-academy-subnav={item.hash}
                data-tooltip={item.tooltip}
                class="theme-chip theme-chip-link ui-tooltip ui-tooltip-bottom rounded-xl px-3.5 py-1.5 text-sm"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      ) : null}
      {showStartSubnav ? (
        <div class="border-t border-[color:var(--theme-border)] px-6 pb-3 pt-2 xl:px-8">
          <nav class="flex flex-wrap justify-center gap-2" aria-label={locale === 'ja' ? 'Start guide sections' : '新手起步分段导航'}>
            {startSubnavItems.map((item) => (
              <a
                href={item.href}
                data-start-subnav={item.hash}
                data-tooltip={item.tooltip}
                class="theme-chip theme-chip-link ui-tooltip ui-tooltip-bottom rounded-xl px-3.5 py-1.5 text-sm"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      ) : null}
    </header>

    <main id="main-content" class="mx-auto max-w-6xl px-5 py-7 sm:px-6 sm:py-10">
      <slot />
    </main>
    <PersistentAudioPlayer />
    <script is:inline data-astro-rerun>
      (() => {
        const links = Array.from(document.querySelectorAll('[data-radar-subnav]'));
        if (links.length === 0) return;

        const isRadarArchive = Boolean(document.querySelector('[data-radar-view]'));
        if (isRadarArchive) return;

        const abortController = new AbortController();

        for (const link of links) {
          link.addEventListener(
            'click',
            (event) => {
              const href = event.currentTarget?.getAttribute('href');
              if (!href) return;

              event.preventDefault();
              window.location.assign(href);
            },
            { signal: abortController.signal },
          );
        }

        document.addEventListener('astro:before-swap', () => abortController.abort(), { once: true });
      })();
    </script>
  </body>
</html>
