---
import BaseLayout from '../../components/BaseLayout.astro';
import StartPage from '../../components/StartPage.astro';
import { startPage } from '../../lib/i18n';
import { startPath } from '../../lib/site';

const text = startPage.zh;
---

<BaseLayout
  title={`${text.title} · Good Good Study, Day Day AI`}
  description={text.metaDescription}
  locale="zh"
  languagePaths={{ ja: startPath('ja') }}
  showStartSubnav
>
  <StartPage locale="zh" />
</BaseLayout>
