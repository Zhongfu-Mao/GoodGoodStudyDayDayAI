---
import BaseLayout from '../components/BaseLayout.astro';
import CategoryPage from '../components/CategoryPage.astro';
import { collectionLabels, collectionNames, type CollectionName } from '../lib/site';

export async function getStaticPaths() {
  return collectionNames.map((category) => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props as { category: CollectionName };
---

<BaseLayout title={`${collectionLabels[category].zh} · Good Good Study, Day Day AI`} locale="zh">
  <CategoryPage locale="zh" category={category} />
</BaseLayout>
