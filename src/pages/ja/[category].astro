---
import BaseLayout from '../../components/BaseLayout.astro';
import CategoryPage from '../../components/CategoryPage.astro';
import { collectionLabels, primaryCategoryNames, type CollectionName } from '../../lib/site';

export async function getStaticPaths() {
  return primaryCategoryNames.map((category) => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props as { category: CollectionName };
---

<BaseLayout title={`${collectionLabels[category].ja} · Good Good Study, Day Day AI`} locale="ja" activeCategory={category}>
  <CategoryPage locale="ja" category={category} />
</BaseLayout>
