---
import BaseLayout from '../../../components/BaseLayout.astro';
import RadarGalleryPage from '../../../components/RadarGalleryPage.astro';
import { radarGalleryPage } from '../../../lib/i18n';
import { radarGalleryPath } from '../../../lib/site';

const text = radarGalleryPage.ja;
---

<BaseLayout
  title={`${text.title} · Good Good Study, Day Day AI`}
  description={text.description}
  locale="ja"
  languagePaths={{ zh: radarGalleryPath('zh'), ja: radarGalleryPath('ja') }}
  activeCategory="radar"
>
  <RadarGalleryPage locale="ja" />
</BaseLayout>
