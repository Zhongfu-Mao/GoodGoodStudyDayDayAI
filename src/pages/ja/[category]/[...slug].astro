---
import BaseLayout from '../../../components/BaseLayout.astro';
import PostDetailPage from '../../../components/PostDetailPage.astro';
import { getEntriesForLocale, getEntryForRoute, getPostStaticPaths } from '../../../lib/content';
import { articlePath, categoryPath, stripLocaleSuffix, type CollectionName } from '../../../lib/site';
import { render } from 'astro:content';

export async function getStaticPaths() {
  return getPostStaticPaths('ja');
}

const { entryId, collection } = Astro.props as { entryId: string; collection: CollectionName };
const entry = await getEntryForRoute(collection, entryId);

if (!entry) {
  throw new Error(`Missing entry for ${collection}/${entryId}`);
}

const currentSlug = stripLocaleSuffix(entry.id, 'ja');
const zhEntries = await getEntriesForLocale('zh');
const zhMatch = zhEntries.find((item) => item.collection === collection && item.slug === currentSlug);
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} · Good Good Study, Day Day AI`}
  description={entry.data.description}
  languagePaths={{
    zh: zhMatch ? articlePath(collection, zhMatch.slug, 'zh') : categoryPath(collection, 'zh'),
    ja: articlePath(collection, currentSlug, 'ja'),
  }}
  locale="ja"
>
  <PostDetailPage locale="ja" entry={entry} Content={Content} />
</BaseLayout>
