---
import BaseLayout from '../../../components/BaseLayout.astro';
import PostDetailPage from '../../../components/PostDetailPage.astro';
import {
  getEntryForRoute,
  getLanguagePathsForEntry,
  getPostStaticPaths,
} from '../../../lib/content';
import type { CollectionName } from '../../../lib/site';
import { stripLocaleSuffix } from '../../../lib/site';
import { buildBlogPostingJsonLd } from '../../../lib/structuredData';
import { render } from 'astro:content';

export async function getStaticPaths() {
  return getPostStaticPaths('ja');
}

const { entryId, collection } = Astro.props as { entryId: string; collection: CollectionName };
const entry = await getEntryForRoute(collection, entryId);

if (!entry) {
  throw new Error(`Missing entry for ${collection}/${entryId}`);
}

const { Content, headings } = await render(entry);
const languagePaths = await getLanguagePathsForEntry(collection, entry, 'ja');
const slug = stripLocaleSuffix(entry.id, 'ja');
const structuredData = buildBlogPostingJsonLd({ entry, slug, locale: 'ja', site: Astro.site });
---

<BaseLayout
  title={`${entry.data.title} · Good Good Study, Day Day AI`}
  description={entry.data.description}
  languagePaths={languagePaths}
  locale="ja"
  ogType="article"
  ogImage={entry.data.coverImage}
  publishedTime={entry.data.date.toISOString()}
  modifiedTime={(entry.data.updatedDate ?? entry.data.date).toISOString()}
  activeCategory={entry.data.category}
  structuredData={structuredData}
>
  <PostDetailPage locale="ja" entry={entry} Content={Content} headings={headings} />
</BaseLayout>
