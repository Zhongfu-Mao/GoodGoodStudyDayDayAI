---
import BaseLayout from '../../components/BaseLayout.astro';
import PostDetailPage from '../../components/PostDetailPage.astro';
import { getEntriesForLocale, getEntryForRoute, getPostStaticPaths } from '../../lib/content';
import { articlePath, categoryPath, stripLocaleSuffix, type CollectionName } from '../../lib/site';
import { render } from 'astro:content';

export async function getStaticPaths() {
  return getPostStaticPaths('zh');
}

const { entryId, collection } = Astro.props as { entryId: string; collection: CollectionName };
const entry = await getEntryForRoute(collection, entryId);

if (!entry) {
  throw new Error(`Missing entry for ${collection}/${entryId}`);
}

const currentSlug = stripLocaleSuffix(entry.id, 'zh');
const jaEntries = await getEntriesForLocale('ja');
const jaMatch = jaEntries.find((item) => item.collection === collection && item.slug === currentSlug);
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} · Good Good Study, Day Day AI`}
  description={entry.data.description}
  languagePaths={{
    zh: articlePath(collection, currentSlug, 'zh'),
    ja: jaMatch ? articlePath(collection, jaMatch.slug, 'ja') : categoryPath(collection, 'ja'),
  }}
  locale="zh"
>
  <PostDetailPage locale="zh" entry={entry} Content={Content} />
</BaseLayout>
