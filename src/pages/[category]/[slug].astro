---
import BaseLayout from '../../components/BaseLayout.astro';
import PostDetailPage from '../../components/PostDetailPage.astro';
import { getEntryForRoute, getPostStaticPaths } from '../../lib/content';
import { type CollectionName } from '../../lib/site';
import { render } from 'astro:content';

export async function getStaticPaths() {
  return getPostStaticPaths('zh');
}

const { entryId, collection } = Astro.props as { entryId: string; collection: CollectionName };
const entry = await getEntryForRoute(collection, entryId);

if (!entry) {
  throw new Error(`Missing entry for ${collection}/${entryId}`);
}

const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} · Good Good Study, Day Day AI`} locale="zh">
  <PostDetailPage locale="zh" entry={entry} Content={Content} />
</BaseLayout>
