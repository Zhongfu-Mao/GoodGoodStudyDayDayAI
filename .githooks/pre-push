#!/bin/sh
set -e

echo "Running pre-push quality checks..."
checked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  node scripts/check/radar-media.mjs --ref "$local_sha"
  checked=1
done
# Also allow explicitly running the hook from a terminal without Git's stdin.
if [ "$checked" -eq 0 ]; then
  node scripts/check/radar-media.mjs --ref HEAD
fi
npm run check
npm run test:ui
