{
  "name": "good-good-study-day-day-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:test": "node scripts/preview-static.mjs",
    "check": "astro check",
    "check:tags": "node scripts/check/bilingual-tags.mjs",
    "check:radar-build": "node scripts/check/radar-build-smoke.mjs",
    "check:radar-newsletter": "node scripts/check/radar-newsletter-sections.mjs",
    "check:radar-sources": "node scripts/check/radar-source-diversity.mjs",
    "check:radar-schema": "node scripts/check/radar-schema.mjs",
    "check:radar-dedupe": "node scripts/check/radar-dedupe.mjs",
    "check:radar-media": "node scripts/check/radar-media.mjs",
    "check:r2-public-base": "node scripts/check/r2-guardrails.mjs --env-only",
    "audit:r2-public-urls": "node scripts/check/r2-guardrails.mjs --scan-content",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "setup:hooks": "git config core.hooksPath .githooks",
    "test:unit": "vitest run",
    "test:ui": "GITHUB_REPOSITORY=Zhongfu-Mao/GoodGoodStudyDayDayAI npm run build && GITHUB_REPOSITORY=Zhongfu-Mao/GoodGoodStudyDayDayAI playwright test",
    "test:ui:root": "npm run build && playwright test",
    "test:ui:headed": "GITHUB_REPOSITORY=Zhongfu-Mao/GoodGoodStudyDayDayAI npm run build && GITHUB_REPOSITORY=Zhongfu-Mao/GoodGoodStudyDayDayAI playwright test --headed",
    "test:ui:update-snapshots": "GITHUB_REPOSITORY=Zhongfu-Mao/GoodGoodStudyDayDayAI npm run build && GITHUB_REPOSITORY=Zhongfu-Mao/GoodGoodStudyDayDayAI playwright test tests/ui/visual-regression.spec.ts --update-snapshots",
    "audio:compress": "node scripts/radar/compress-audio.mjs",
    "images:compress": "node scripts/radar/compress-images.mjs",
    "assets:migrate:r2": "node scripts/radar/migrate-assets-to-r2.mjs",
    "podcast:cover": "node scripts/radar/generate-podcast-cover.mjs",
    "podcast:cover:concepts": "node scripts/radar/generate-podcast-cover-concepts.mjs",
    "academy:covers:openai": "node scripts/academy/localize-openai-covers.mjs",
    "radar:images": "node scripts/radar/fill-images.mjs",
    "radar:audio": "node scripts/radar/generate-audio.mjs",
    "radar:infographic": "node scripts/radar/generate-infographic.mjs",
    "radar:infographic:openai": "node scripts/radar/generate-infographic.mjs --backend openai",
    "radar:weekly-assets": "node scripts/radar/generate-weekly-assets.mjs",
    "radar:monthly-assets": "node scripts/radar/generate-monthly-assets.mjs",
    "radar:notebook-cleanup": "node scripts/radar/cleanup-notebooks.mjs",
    "check:radar-editorial": "node scripts/check/radar-editorial.mjs",
    "check:radar": "npm run check:radar-newsletter && npm run check:radar-sources && npm run check:radar-schema && npm run check:radar-dedupe && npm run check:radar-media && npm run check:radar-editorial"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@aws-sdk/client-s3": "^3.1147.0",
    "astro": "^7.3.6",
    "astro-pagefind": "^2.0.1",
    "clsx": "^2.1.1",
    "pdfjs-dist": "^6.4.299",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@mozilla/readability": "^0.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
