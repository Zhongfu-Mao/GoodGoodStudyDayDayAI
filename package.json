{
  "name": "good-good-study-day-day-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:tags": "node scripts/check-bilingual-tags.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "test:unit": "vitest run",
    "test:ui": "npm run build && playwright test",
    "test:ui:headed": "npm run build && playwright test --headed",
    "radar:audio": "node scripts/generate-radar-audio.mjs",
    "radar:infographic": "node scripts/generate-radar-infographic.mjs",
    "radar:infographic:openai": "node scripts/generate-radar-infographic.mjs --backend openai",
    "radar:weekly-assets": "node scripts/generate-radar-weekly-assets.mjs",
    "radar:monthly-assets": "node scripts/generate-radar-monthly-assets.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^5.13.0",
    "astro-pagefind": "^1.8.6",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/tailwind": "^6.0.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
