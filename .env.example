# Canonical site URL used by Astro for RSS, sitemap, and structured data.
SITE_URL=https://example.com

# Optional analytics. Leave PUBLIC_ANALYTICS_PROVIDER blank to disable.
# Supported values: cloudflare, plausible, umami
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=

# Optional Cloudflare R2 media storage for radar audio, decks, and infographics.
# R2 is opt-in. Leave R2_ENABLED unset/0 to keep media on GitHub Pages under
# public/audio, public/images, and public/decks.
# When R2_ENABLED=1 and all five values below are present, radar generation
# scripts upload assets to R2 and write absolute media URLs into frontmatter.
# R2_PUBLIC_BASE must be a custom domain behind Cloudflare Cache/WAF.
# Do not use an r2.dev public development URL for production podcast media.
R2_ENABLED=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ggsdda-media
R2_PUBLIC_BASE=https://media.example.com
